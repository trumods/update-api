                                                <span style={{ background: "rgba(245, 158, 11, 0.2)", color: "#fbbf24", padding: "2px 6px", borderRadius: "5px", fontWeight: "bold", fontSize: "10.5px", flexShrink: 0 }}>
                                                    👑 #{msgNum}
                                                </span>
                                                <span style={{ fontFamily: "monospace", color: t.text, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>
                                                    {seqItem.fileName}
                                                </span>
                                            </div>
                                            <div style={{ display: "flex", gap: "4px", flexShrink: 0 }}>
                                                <button
                                                    type="button"
                                                    disabled={idx === 0}
                                                    onClick={() => moveVipSeqItem(idx, -1)}
                                                    style={{ padding: "2px 7px", background: idx === 0 ? "transparent" : "#334155", color: idx === 0 ? "#475569" : "#fff", border: "none", borderRadius: "4px", cursor: idx === 0 ? "default" : "pointer", fontSize: "11px", fontWeight: "bold" }}
                                                >
                                                    ▲
                                                </button>
                                                <button
                                                    type="button"
                                                    disabled={idx === vipOrderedItems.length - 1}
                                                    onClick={() => moveVipSeqItem(idx, 1)}
                                                    style={{ padding: "2px 7px", background: idx === vipOrderedItems.length - 1 ? "transparent" : "#334155", color: idx === vipOrderedItems.length - 1 ? "#475569" : "#fff", border: "none", borderRadius: "4px", cursor: idx === vipOrderedItems.length - 1 ? "default" : "pointer", fontSize: "11px", fontWeight: "bold" }}
                                                >
                                                    ▼
                                                </button>
                                            </div>
                                        </div>
                                    );
                                })}
                            </div>
                        </div>
                    )}
                </div>

                <div style={{ display: "flex", gap: "8px" }}>
                    <button
                        type="button"
                        onClick={handleBulkSyncPpdToDb}
                        disabled={isSyncingPpd || liveParsedPreviewCount === 0}
                        style={{ flex: 1, padding: "12px", background: "linear-gradient(135deg, #10b981, #059669)", color: "#fff", border: "none", borderRadius: "10px", fontWeight: "bold", fontSize: "13.5px", cursor: isSyncingPpd ? "wait" : "pointer" }}
                    >
                        {isSyncingPpd ? "⏳ Syncing & Updating Database..." : `⚡ Sync & Auto-Update All in DB (${liveParsedPreviewCount})`}
                    </button>
                    <button
                        type="button"
                        onClick={() => {
                            if (!window.confirm("Clear synced PPD list & VIP sequence?")) return;
                            setPpdRawText("");
                            setPpdSyncedList([]);
                            setPpdProcessedIds([]);
                            setPpdCompletedIds([]);
                            setPpdSyncTime("");
                            setVipOrderedItems([]);
                            setVipLinksMap({});
                            localStorage.removeItem("savedPpdRawText");
                            localStorage.removeItem("savedPpdSyncedList");
                            localStorage.removeItem("savedPpdProcessedIds");
                            localStorage.removeItem("savedPpdCompletedIds");
                            localStorage.removeItem("savedPpdSyncTime");
                            localStorage.removeItem("savedVipOrderedItems");
                            localStorage.removeItem("savedVipLinksMap");
                        }}
                        title="Clear List"
                        style={{ padding: "0 16px", background: "rgba(244, 63, 94, 0.12)", color: "#f43f5e", border: "1px solid rgba(244, 63, 94, 0.25)", borderRadius: "10px", fontWeight: "bold", cursor: "pointer" }}
                    >
                        🗑️
                    </button>
                </div>

                {ppdSyncedList.length > 0 && (
                    <div style={{ marginTop: "18px", paddingTop: "14px", borderTop: `1px solid ${t.border}` }}>
                        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "10px", flexWrap: "wrap", gap: "8px" }}>
                            <div>
                                <div style={{ fontSize: "13px", fontWeight: "bold", color: "#38bdf8" }}>
                                    📋 Synced Apps Queue ({ppdCompletedIds.length}/{ppdSyncedList.length} Completed)
                                </div>
                                {ppdSyncTime && (
                                    <div style={{ fontSize: "11px", color: t.textMuted }}>
                                        🕒 Last Synced at {ppdSyncTime} (Saved in Browser)
                                    </div>
                                )}
                            </div>

                            <button
                                type="button"
                                onClick={() => setPpdShowPendingOnly(!ppdShowPendingOnly)}
                                style={{
                                    padding: "5px 10px",
                                    borderRadius: "20px",
                                    fontSize: "11px",
                                    fontWeight: "bold",
                                    cursor: "pointer",
                                    background: ppdShowPendingOnly ? "rgba(245, 158, 11, 0.2)" : t.itemBg,
                                    color: ppdShowPendingOnly ? "#fbbf24" : t.textMuted,
                                    border: ppdShowPendingOnly ? "1px solid rgba(245, 158, 11, 0.4)" : `1px solid ${t.border}`
                                }}
                            >
                                {ppdShowPendingOnly ? "🔥 Showing Pending Only" : "⏳ Filter Pending Only"}
                            </button>
                        </div>

                        <div style={{ display: "flex", flexDirection: "column", gap: "8px", maxHeight: "420px", overflowY: "auto", paddingRight: "2px" }}>
                            {visiblePpdQueue.map((item, idx) => {
                                const isOpened = ppdProcessedIds.includes(item.packageId);
                                const isCompleted = ppdCompletedIds.includes(item.packageId);
                                const itemVip = item.vipLink || getVipLinkForPkg(item.packageId);
                                const vipShortId = itemVip ? itemVip.split("/").pop() : "";
                                return (
                                    <div
                                        key={idx}
                                        style={{
                                            padding: "10px 12px",
                                            backgroundColor: isCompleted ? "rgba(16, 185, 129, 0.1)" : (isOpened ? "rgba(14, 165, 233, 0.08)" : t.itemBg),
                                            border: isCompleted ? "1px solid rgba(16, 185, 129, 0.4)" : (isOpened ? "1px solid rgba(14, 165, 233, 0.35)" : `1px solid ${t.border}`),
                                            borderRadius: "10px",
                                            display: "flex",
                                            justifyContent: "space-between",
                                            alignItems: "center",
                                            gap: "10px",
                                            flexWrap: "wrap"
                                        }}
                                    >
                                        <div style={{ flex: 1, minWidth: "180px" }}>
                                            <div style={{ display: "flex", alignItems: "center", gap: "6px", flexWrap: "wrap" }}>
                                                <span style={{ fontWeight: "bold", fontSize: "13.5px", color: t.text }}>
                                                    {item.appName}
                                                </span>
                                                <span style={{ color: "#10b981", fontWeight: "bold", fontSize: "12.5px" }}>
                                                    v{item.version}
                                                </span>
                                                {item.sizeMB && (
                                                    <span style={{ background: "rgba(14, 165, 233, 0.15)", color: "#38bdf8", padding: "1px 6px", borderRadius: "6px", fontSize: "11px", fontWeight: "bold" }}>
                                                        {item.sizeMB}MB
                                                    </span>
                                                )}
                                                {item.dupVersion && !isCompleted && (
                                                    <span style={{ background: "rgba(245, 158, 11, 0.2)", color: "#fbbf24", padding: "1px 6px", borderRadius: "6px", fontSize: "10.5px", fontWeight: "bold" }}>⚠️ Same version</span>
                                                )}
                                                {vipShortId && (
                                                    <span style={{ background: "rgba(245, 158, 11, 0.2)", color: "#fbbf24", padding: "1px 6px", borderRadius: "6px", fontSize: "10.5px", fontWeight: "bold" }}>
                                                        👑 #{vipShortId}
                                                    </span>
                                                )}
                                                <span style={{
                                                    background: isCompleted ? "rgba(16, 185, 129, 0.2)" : (item.inDb ? "rgba(16, 185, 129, 0.12)" : "rgba(245, 158, 11, 0.15)"),
                                                    color: isCompleted ? "#10b981" : (item.inDb ? "#34d399" : "#fbbf24"),
                                                    padding: "1px 6px",
                                                    borderRadius: "6px",
                                                    fontSize: "10.5px",
                                                    fontWeight: "bold"
                                                }}>
                                                    {isCompleted ? "✅ Done (Applied)" : (isOpened ? "👁️ Opened" : (item.inDb ? "⏳ Ready in DB" : "🆕 Not in DB"))}
                                                </span>
                                            </div>
                                            <div style={{ fontSize: "11.5px", color: t.textMuted, fontFamily: "monospace", marginTop: "2px" }}>
                                                {item.packageId}
                                            </div>
                                        </div>

                                        <div style={{ display: "flex", gap: "6px", alignItems: "center" }}>
                                            <button
                                                type="button"
                                                onClick={() => {
                                                    navigator.clipboard.writeText(item.packageId);
                                                    setPpdCopiedPkg(item.packageId);
                                                    setTimeout(() => setPpdCopiedPkg(""), 1500);
                                                }}
                                                style={{
                                                    padding: "6px 10px",
                                                    background: ppdCopiedPkg === item.packageId ? "#10b981" : t.inputBg,
                                                    color: ppdCopiedPkg === item.packageId ? "#fff" : t.text,
                                                    border: `1px solid ${t.border}`,
                                                    borderRadius: "6px",
                                                    fontSize: "11.5px",
                                                    fontWeight: "bold",
                                                    cursor: "pointer"
                                                }}
                                            >
                                                {ppdCopiedPkg === item.packageId ? "✓ ID" : "📋 ID"}
                                            </button>

                                            {item.inDb ? (
                                                <button
                                                    type="button"
                                                    onClick={() => openPpdItemInDbUpdate(item)}
                                                    style={{
                                                        padding: "6px 12px",
                                                        background: isCompleted ? "#059669" : (isOpened ? "#0284c7" : "linear-gradient(135deg, #10b981, #059669)"),
                                                        color: "#fff",
                                                        border: "none",
                                                        borderRadius: "6px",
                                                        fontSize: "12px",
                                                        fontWeight: "bold",
                                                        cursor: "pointer"
                                                    }}
                                                >
                                                    {isCompleted ? "✅ Completed" : (isOpened ? "👁️ Opened in DB" : "🔄 Open in DB Update")}
                                                </button>
                                            ) : (
                                                <button
                                                    type="button"
                                                    onClick={() => openPpdItemInGenerate(item)}
                                                    style={{
                                                        padding: "6px 12px",
                                                        background: isCompleted ? "#059669" : "linear-gradient(135deg, #0ea5e9, #2563eb)",
                                                        color: "#fff",
                                                        border: "none",
                                                        borderRadius: "6px",
                                                        fontSize: "12px",
                                                        fontWeight: "bold",
                                                        cursor: "pointer"
                                                    }}
                                                >
                                                    {isCompleted ? "✅ Completed" : (isOpened ? "👁️ Opened" : "⚙ Open in Generate")}
                                                </button>
                                            )}
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                )}
            </div>
        )}

        {activeMainTab === 'generate' && (
          <form onSubmit={(e) => e.preventDefault()} style={{ display: "flex", flexDirection: "column", gap: "12px", marginBottom: "24px" }}>
            <input type="text" placeholder="Play Store Link or Package Name..." value={link} onChange={(e) => setLink(e.target.value)} style={inputStyle} />
            
            {customImages.map((img, idx) => (
              <div key={`cimg_${idx}`} style={{ display: "flex", gap: "8px", alignItems: "center" }}>
                <input type="text" placeholder={idx === 0 ? "Custom Image Link (Promo Banner)..." : `Custom Image Link ${idx + 1}...`} value={img} onChange={(e) => handleArrChange(customImages, setCustomImages, idx, e.target.value)} style={{ ...inputStyle, flex: 1 }} />
                {idx === customImages.length - 1 ? <button type="button" onClick={() => addArrField(customImages, setCustomImages)} style={{ padding: "14px 20px", background: "rgba(16,185,129,0.15)", color: "#10b981", border: "1px solid rgba(16,185,129,0.2)", borderRadius: "10px", cursor: "pointer", fontSize: "16px" }}>+</button> : <button type="button" onClick={() => rmArrField(customImages, setCustomImages, idx)} style={{ padding: "14px 20px", background: "rgba(244,63,94,0.15)", color: "#f43f5e", border: "1px solid rgba(244,63,94,0.2)", borderRadius: "10px", cursor: "pointer", fontSize: "16px" }}>-</button>}
              </div>
            ))}
            
            {(() => {
               const cleanLinksForCheck = typeof downloadLinksText === 'string' ? downloadLinksText.split('\n').map(l => l.trim()).filter(l => l !== '') : [];
               const hasDups = cleanLinksForCheck.length !== new Set(cleanLinksForCheck).size;
               return hasDups ? <div style={{ color: "#ef4444", fontSize: "12px", fontWeight: "bold", paddingLeft: "5px", marginBottom: "4px" }}>⚠ Duplicate links detected!</div> : null;
            })()}

            <textarea 
               value={downloadLinksText} 
               onChange={(e) => {
                   setDownloadLinksText(e.target.value);
                   localStorage.setItem("savedDownloadLinksText", e.target.value);
               }} 
               style={{ ...inputStyle, height: "80px", padding: "10px 14px", resize: "vertical", fontFamily: "monospace", whiteSpace: "pre" }} 
               placeholder="Main Link&#10;Mirror Link 1&#10;Mirror Link 2..."
            />

            {(settings.enableVipTgLink || settings.autoEditVipApk) && (
              <input
                type="text"
                placeholder="👑 VIP Direct APK Link (Auto-filled from Sequence or Paste https://t.me/c/...)"
                value={genVipLink}
                onChange={(e) => setGenVipLink(e.target.value)}
                style={{ ...inputStyle, padding: "10px 14px", fontSize: "13px", fontFamily: "monospace", border: "1px solid rgba(245, 158, 11, 0.35)" }}
              />
            )}
            
            <div style={{ display: "flex", gap: "8px", marginTop: "8px", flexWrap: "nowrap" }}>
              <button type="button" onClick={() => fetchData('images_only')} disabled={loading} title="Fetch Images Only" style={{ flex: "0 0 56px", padding: "14px", background: "rgba(16,185,129,0.15)", color: "#10b981", border: "1px solid rgba(16,185,129,0.2)", borderRadius: "10px", cursor: loading ? "wait" : "pointer", fontSize: "20px" }}>🖼️</button>
              <button type="button" onClick={() => fetchData('text_only')} disabled={loading} title="Generate Post Only" style={{ flex: "0 0 56px", padding: "14px", background: "rgba(245,158,11,0.15)", color: "#f59e0b", border: "1px solid rgba(245,158,11,0.2)", borderRadius: "10px", cursor: loading ? "wait" : "pointer", fontSize: "20px" }}>📝</button>
              <button type="button" onClick={() => fetchData('both')} disabled={loading} title="Generate Post + Images" style={{ flex: 1, padding: "14px", background: "linear-gradient(135deg, #0ea5e9, #2563eb)", color: "#fff", border: "none", borderRadius: "10px", fontWeight: "700", cursor: loading ? "wait" : "pointer", fontSize: "15px" }}>{loading ? "⏳ Wait..." : "⚡ Both"}</button>
              <button type="button" onClick={clearFields} title="Clear All Fields" style={{ flex: "0 0 56px", padding: "14px", backgroundColor: isDarkTheme ? "rgba(255,255,255,0.05)" : "rgba(0,0,0,0.05)", color: t.textMuted, border: `1px solid ${t.border}`, borderRadius: "10px", cursor: "pointer", fontSize: "18px" }}>🗑️</button>
            </div>
          </form>
        )}

        {activeMainTab === 'database' && (
            <div style={cardStyle}>
                <div style={{ display: "flex", gap: "8px", marginBottom: "16px", position: "relative", zIndex: 30 }}>
                    <div style={{ flex: 1, position: "relative" }}>
                        <input type="text" placeholder="Search Database by Package ID or Name..." value={updateSearch} 
                            onChange={(e) => { 
                                setUpdateSearch(e.target.value); 
                                if(settings.localCache) setShowDropdown(true); 
                            }} 
                            onFocus={() => { if(settings.localCache && updateSearch) setShowDropdown(true); }}
                            style={{...inputStyle, width: "100%"}} 
                        />
                        {settings.localCache && showDropdown && updateSearch && (
                            <div style={{ position: "absolute", top: "100%", left: 0, right: 0, backgroundColor: t.modalBg, border: `1px solid ${t.borderSolid}`, borderRadius: "8px", maxHeight: "250px", overflowY: "auto", marginTop: "4px", boxShadow: "0 10px 15px -3px rgba(0,0,0,0.3)" }}>
                                {filteredApps.length > 0 ? filteredApps.map((app, idx) => (
                                    <div key={idx} onClick={() => loadAppFromCache(app)} style={{ padding: "10px 14px", borderBottom: `1px solid ${t.border}`, cursor: "pointer", color: t.text, backgroundColor: t.itemBg }}>
                                        <div style={{ fontWeight: "bold", fontSize: "14px", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{app.appName || "App"}</div>
                                        <div style={{ fontSize: "12px", color: t.textMuted, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{app.appId} • v{app.version}</div>
                                    </div>
                                )) : <div style={{ padding: "10px 14px", fontSize: "13px", color: t.textMuted }}>No apps found in cache.</div>}
                            </div>
                        )}
                    </div>
                    <button onClick={clearDbUI} title="Clear Database fields" style={{ flex: "0 0 auto", padding: "0 14px", background: "rgba(244, 63, 94, 0.1)", color: "#f43f5e", border: "1px solid rgba(244, 63, 94, 0.2)", borderRadius: "10px", cursor: "pointer", fontSize: "14px" }}>✖</button>
                    <button onClick={fetchLocalDb} disabled={updateLoading || isCaching} style={{ padding: "0 18px", background: "#10b981", color: "#fff", border: "none", borderRadius: "10px", fontWeight: "bold", cursor: (updateLoading || isCaching) ? "wait" : "pointer", whiteSpace: "nowrap", fontSize: "18px" }} title="Load DB">
                        {isCaching ? "⏳" : updateLoading ? "⏳" : "🔍"}
                    </button>
                </div>

                {dbAppId && dbSubTab === 'form' && (
                    <div style={{ padding: "16px", backgroundColor: "rgba(16, 185, 129, 0.05)", border: "1px solid rgba(16, 185, 129, 0.2)", borderRadius: "12px" }}>
                        <h4 style={{margin: "0 0 12px 0", color: "#10b981", fontSize: "15px"}}>📱 {dbAppName}</h4>
                        
                        <div style={{ display: "flex", gap: "8px", marginBottom: "12px" }}>
                            <input type="text" value={dbAppTitle} onChange={(e) => setDbAppTitle(e.target.value)} onBlur={() => { const pb = parseTitleParts(dbAppTitle); if (pb.build) { setDbBuild(pb.build); setShowBuildBox(true); } }} style={{...inputStyle, flex: 1, padding: "10px 14px", fontWeight: "bold"}} placeholder="Post Title" />
                        </div>

                        <div style={{ display: "flex", flexWrap: "wrap", gap: "8px", marginBottom: (versionMismatch || dupWarn) ? "2px" : "12px", alignItems: "stretch" }}>
                            <div style={{ flex: "1 1 120px", minWidth: "110px", position: "relative" }}>
                                <input 
                                    type="text" 
                                    value={dbVersion} 
                                    onChange={(e) => { setDbVersion(e.target.value); setVersionMismatch(false); }} 
                                    style={{
                                        ...inputStyle, width: "100%", boxSizing: "border-box", padding: "10px 14px", paddingRight: (!showBuildBox && dbVersion.trim() !== "") ? "42px" : "14px",
                                        border: versionMismatch ? "2px solid #ef4444" : `1px solid ${t.border}`,
                                        boxShadow: versionMismatch ? "0 0 10px rgba(239, 68, 68, 0.3)" : "none"
                                    }} 
                                    placeholder="Version" 
                                />
                                {(!showBuildBox && dbVersion.trim() !== "") && (
                                    <button type="button" onClick={() => setShowBuildBox(true)} title="Add build code (b123)" style={{ position: "absolute", right: "6px", top: "50%", transform: "translateY(-50%)", width: "28px", height: "28px", padding: 0, display: "flex", alignItems: "center", justifyContent: "center", background: "rgba(139, 92, 246, 0.15)", color: "#a78bfa", border: "1px solid rgba(139, 92, 246, 0.35)", borderRadius: "7px", cursor: "pointer", fontSize: "16px", fontWeight: "bold", lineHeight: 1 }}>＋</button>
                                )}
                            </div>
                            <button onClick={handleResetDbData} title="Reset to DB Data" style={{ flex: "0 0 auto", padding: "0 14px", background: versionMismatch ? "rgba(239, 68, 68, 0.15)" : "rgba(245, 158, 11, 0.1)", color: versionMismatch ? "#ef4444" : "#f59e0b", border: versionMismatch ? "1px solid #ef4444" : "1px solid rgba(245, 158, 11, 0.2)", borderRadius: "8px", cursor: "pointer", fontSize: "16px" }}>🔄</button>
                            <button onClick={() => fetchLatestPlayStore()} disabled={playStoreLoading} title="Fetch PlayStore Data" style={{ flex: "0 0 auto", padding: "0 14px", background: "rgba(14, 165, 233, 0.1)", color: "#0ea5e9", border: "1px solid rgba(14, 165, 233, 0.2)", borderRadius: "8px", cursor: "pointer", fontSize: "16px" }}>{playStoreLoading ? "⏳" : "⚡"}</button>
                            {showBuildBox && (
                                <input
                                    type="text"
                                    value={dbBuild}
                                    onChange={(e) => { setDbBuild(e.target.value); if (dupWarn) setDupWarn(false); }}
                                    onBlur={() => {
                                        const nb = normalizeBuild(dbBuild);
                                        setDbBuild(nb);
                                        setDbAppTitle(prev => { const pp = parseTitleParts(prev); return pp.hasVersion ? composeTitle({ ...pp, build: nb }) : prev; });
                                    }}
                                    placeholder="b123"
                                    title="Build code (type 123 → b123). Empty = no build"
                                    style={{
                                        ...inputStyle, flex: "1 1 92px", minWidth: "92px", boxSizing: "border-box", padding: "10px 8px", textAlign: "center", fontWeight: "bold",
                                        border: dupWarn ? "2px solid #f59e0b" : `1px solid ${t.border}`,
                                        boxShadow: dupWarn ? "0 0 10px rgba(245, 158, 11, 0.35)" : "none"
                                    }}
                                />
                            )}
                        </div>
                        {versionMismatch && (
                            <div style={{ color: "#ef4444", fontSize: "11px", fontWeight: "bold", marginBottom: "12px", paddingLeft: "4px" }}>
                                ⚠️ Warning: Version Mismatch! PlayStore = v{psFetchedVersion} | Your Link = v{originalDbData?.version}
                            </div>
                        )}
                        {dupWarn && (
                            <div style={{ color: "#f59e0b", fontSize: "11px", fontWeight: "bold", marginBottom: "12px", paddingLeft: "4px" }}>
                                ⚠️ Same version already in DB — add a new build code (e.g. b124)
                            </div>
                        )}
                        {playStoreFetched && !versionMismatch && (
                            <div style={{ color: "#10b981", fontSize: "11px", fontWeight: "bold", marginBottom: "12px", paddingLeft: "4px" }}>
                                ✅ PlayStore Data Fetched & Applied
                            </div>
                        )}

                        <div style={{ display: "flex", gap: "8px", marginBottom: "12px" }}>
                            <input type="text" value={dbReqText} onChange={(e) => setDbReqText(e.target.value)} style={{...inputStyle, flex: 1, padding: "10px 14px"}} placeholder="Android Requirement (e.g. 7.0 and up)" />
                            
                            {/* SIZE BOX WITH RED WARNING */}
                            <div style={{
                                display: 'flex', alignItems: 'center', 
                                background: sizeWarning ? "rgba(239, 68, 68, 0.12)" : t.inputBg, 
                                border: sizeWarning ? "1.5px solid #ef4444" : `1px solid ${t.border}`, 
                                borderRadius: '10px', paddingRight: '10px',
                                boxShadow: sizeWarning ? "0 0 10px rgba(239, 68, 68, 0.25)" : "none",
                                transition: "all 0.2s ease"
                            }}>
                                <input 
                                    type="text" 
                                    value={dbAppSize} 
                                    onChange={(e) => { setDbAppSize(e.target.value); if (sizeWarning) setSizeWarning(false); }} 
                                    style={{...inputStyle, width: '70px', border: 'none', background: 'transparent', padding: "10px 8px", color: sizeWarning ? "#ef4444" : t.text, fontWeight: sizeWarning ? "bold" : "normal"}} 
                                    placeholder={sizeWarning ? "⚠️ Size?" : "Size"} 
                                />
                                <span style={{color: sizeWarning ? "#ef4444" : t.textMuted, fontWeight: 'bold', fontSize: '13px'}}>MB</span>
                            </div>
                        </div>

                        <div style={{ marginBottom: "12px" }}>
                            <textarea value={dbChangelog} onChange={(e) => setDbChangelog(e.target.value)} style={{...inputStyle, height: "100px", padding: "10px 14px", resize: "vertical"}} placeholder="Changelog will appear here..."></textarea>
                        </div>
                        
                        <div style={{ marginBottom: "16px" }}>
