  const [showVipSeqAdjuster, setShowVipSeqAdjuster] = useState(false);

  // --- UNIVERSAL FILE MANAGER NATURAL A-Z COMPARATOR ---
  // Matches Android / MT Manager sorting: case-insensitive, symbols (., _, -) before letters, natural numbers
  const compareFileManagerNames = (nameA, nameB) => {
    const a = String(nameA || "").trim().toLowerCase();
    const b = String(nameB || "").trim().toLowerCase();
    if (a === b) return 0;

    const chunksA = a.split(/(\d+)/);
    const chunksB = b.split(/(\d+)/);
    const len = Math.min(chunksA.length, chunksB.length);

    for (let i = 0; i < len; i++) {
      const partA = chunksA[i];
      const partB = chunksB[i];
      if (partA === partB) continue;

      const isNumA = /^\d+$/.test(partA);
      const isNumB = /^\d+$/.test(partB);
      if (isNumA && isNumB) {
        const diff = parseInt(partA, 10) - parseInt(partB, 10);
        if (diff !== 0) return diff;
      }
      return partA < partB ? -1 : 1;
    }
    return chunksA.length - chunksB.length;
  };

  // Parse 1st VIP Post Link: "https://t.me/c/3776477470/17" -> { prefix: "https://t.me/c/3776477470/", startNum: 17 }
  const parseVipBaseLink = (urlStr) => {
    if (!urlStr || typeof urlStr !== "string") return null;
    const m = urlStr.trim().match(/^(https?:\/\/t\.me\/(?:c\/\d+|[a-zA-Z0-9_]+)\/)(\d+)\/?$/i);
    if (!m) return null;
    return {
      prefix: m[1],
      startNum: parseInt(m[2], 10)
    };
  };

  // Extract clean APK filename & packageId from any header line
  const extractFileAndPkgFromHeader = (rawLine) => {
    if (!rawLine || typeof rawLine !== "string") return null;
    const trimmed = rawLine.trim();
    if (!trimmed || /^https?:\/\//i.test(trimmed)) return null;

    const cleanFileName = trimmed
      .replace(/^\d+\.\s*/, "")
      .replace(/\s*\[\s*[\d.]+\s*MB\s*\]/i, "")
      .trim();

    const withoutApk = cleanFileName.replace(/\.apk$/i, "").trim();
    const pkgMatch = withoutApk.match(/^([a-zA-Z0-9._]+?)[\s_]+v(?:t\.)?(\d[\d.a-zA-Z-]*)/i);
    const packageId = pkgMatch ? pkgMatch[1].trim() : withoutApk.split(/[\s_]+/)[0].trim();
    if (!packageId) return null;

    return {
      packageId,
      fileName: cleanFileName.endsWith(".apk") ? cleanFileName : `${withoutApk}.apk`
    };
  };

  // Recompute vipLinksMap whenever vipOrderedItems or vipBaseLink changes
  const recomputeVipMapFromOrder = (orderedList, baseLinkStr) => {
    const parsedBase = parseVipBaseLink(baseLinkStr);
    if (!parsedBase || !Array.isArray(orderedList) || orderedList.length === 0) {
      return {};
    }
    const nextMap = {};
    orderedList.forEach((item, index) => {
      if (item && item.packageId) {
        const linkForApp = `${parsedBase.prefix}${parsedBase.startNum + index}`;
        nextMap[item.packageId.toLowerCase()] = linkForApp;
      }
    });
    return nextMap;
  };

  // Build ordered sequence from PPD text or Custom Sequence text based on vipSortMode
  const buildOrderedVipSequence = (rawPpd, sortMode, customSeqRaw) => {
    let sourceItems = [];

    if (sortMode === "custom" && customSeqRaw && customSeqRaw.trim()) {
      const lines = customSeqRaw.replace(/\r\n/g, "\n").split("\n").map(l => l.trim()).filter(Boolean);
      const seen = new Set();
      for (const l of lines) {
        const info = extractFileAndPkgFromHeader(l);
        if (info && !seen.has(info.packageId.toLowerCase())) {
          seen.add(info.packageId.toLowerCase());
          sourceItems.push(info);
        }
      }
    } else {
      const parsed = parsePpdBulkText(rawPpd);
      const seen = new Set();
      for (const it of parsed) {
        const key = it.packageId.toLowerCase();
        if (!seen.has(key)) {
          seen.add(key);
          sourceItems.push({
            packageId: it.packageId,
            fileName: it.cleanFileName || `${it.packageId}_v${it.version}_Mod.apk`
          });
        }
      }
    }

    if (sortMode === "az") {
      sourceItems.sort((a, b) => compareFileManagerNames(a.fileName, b.fileName));
    } else if (sortMode === "za") {
      sourceItems.sort((a, b) => compareFileManagerNames(b.fileName, a.fileName));
    }
    // For "pasted" and "custom", keep exact line order!
    return sourceItems;
  };

  // Slide item UP (-1) or DOWN (+1) in the VIP sequence adjuster
  const moveVipSeqItem = (idx, direction) => {
    const targetIdx = idx + direction;
    if (targetIdx < 0 || targetIdx >= vipOrderedItems.length) return;
    const updatedOrder = [...vipOrderedItems];
    const temp = updatedOrder[idx];
    updatedOrder[idx] = updatedOrder[targetIdx];
    updatedOrder[targetIdx] = temp;

    setVipOrderedItems(updatedOrder);
    localStorage.setItem("savedVipOrderedItems", JSON.stringify(updatedOrder));

    const newMap = recomputeVipMapFromOrder(updatedOrder, vipBaseLink);
    setVipLinksMap(newMap);
    localStorage.setItem("savedVipLinksMap", JSON.stringify(newMap));

    // Also update any already-synced PPD queue items in memory
    if (ppdSyncedList.length > 0) {
      const updatedSynced = ppdSyncedList.map(it => ({
        ...it,
        vipLink: newMap[(it.packageId || "").toLowerCase()] || it.vipLink || ""
      }));
      setPpdSyncedList(updatedSynced);
      localStorage.setItem("savedPpdSyncedList", JSON.stringify(updatedSynced));
    }
    if (dbAppId && newMap[dbAppId.toLowerCase()]) {
      setDbVipLink(newMap[dbAppId.toLowerCase()]);
    }
  };

  const getVipLinkForPkg = (pkgOrUrl) => {
    if (!pkgOrUrl) return "";
    let cleanPkg = pkgOrUrl.trim();
    const idMatch = cleanPkg.match(/id=([a-zA-Z0-9._]+)/);
    if (idMatch) cleanPkg = idMatch[1];
    return vipLinksMap[cleanPkg.toLowerCase()] || "";
  };

  // --- SMART FILE HOST NAME DETECTOR (BEFORE SHORTENING) ---
  const detectFileHostName = (rawUrl, fallbackLabel = "Main Link") => {
    if (!rawUrl || typeof rawUrl !== "string") return fallbackLabel;
    const u = rawUrl.trim().toLowerCase();
    if (!u.startsWith("http") || u.includes("example.com")) return fallbackLabel;

    if (u.includes("vexfile.")) return "VexFile";
    if (u.includes("upfiles.") || u.includes("upfion.")) return "Upfiles";
    if (u.includes("10drives.")) return "10Drives";
    if (u.includes("up-4ever.")) return "Up4ever";
    if (u.includes("devuploads.")) return "DevUploads";
    if (u.includes("cloudfam.")) return "CloudFam";
    if (u.includes("usersdrive.")) return "UsersDrive";
    if (u.includes("dropgalaxy.")) return "DropGalaxy";
    if (u.includes("uploadrar.")) return "UploadRAR";
    if (u.includes("dailyuploads.")) return "DailyUploads";
    if (u.includes("katfile.")) return "KatFile";
    if (u.includes("mega.nz")) return "Mega";
    if (u.includes("mediafire.")) return "MediaFire";
    if (u.includes("dgdrive.")) return "DGDrive";

    // If URL is already shortened and original wasn't found, keep fallback label
    if (/(shortxlinks|vipshort)\.(com|in|org|net|xyz)/i.test(u)) {
      return fallbackLabel;
    }

    try {
      const host = new URL(rawUrl.trim()).hostname.replace(/^www\./i, "");
      const base = host.split(".")[0];
      if (base && base.length >= 2) {
        return base.charAt(0).toUpperCase() + base.slice(1);
      }
    } catch (e) {}
    return fallbackLabel;
  };

  // --- DUAL SHORTENER HELPER FOR TG POST ONLY (SHORTXLINKS + VIPSHORT) ---
  // TG link: late success => TG post me raw PPD link ki jagah short link khud lag jata hai
  const lateTgPatch = (raw, short) => {
    if (!raw || !short || raw === short) return;
    const swap = (prev) => (prev && prev.indexOf(raw) !== -1 ? prev.split(raw).join(short) : prev);
    setDbTelegramResult(swap);
    setTelegramResult(swap);
    setTgToast("✅ Short link ready — TG post updated");
    setTimeout(() => setTgToast(""), 3000);
  };

  const shortenUrlsForTg = async (urlsArray, providersArray, onLate) => {
    try {
      const waits = await Promise.all(urlsArray.map((u, i) => slGet(u, providersArray[i], 16000)));
      if (waits.some(r => !r.ok)) {
        setTgToast("⚠️ Shortener slow — retrying in background");
        setTimeout(() => setTgToast(""), 3500);
        waits.forEach((r, i) => {
          if (!r.ok && r.pending) r.pending.then(done => { if (done && done.ok && onLate) onLate(String(urlsArray[i] || "").trim(), done.url); });
        });
      }
      return waits.map(r => r.url);
    } catch (e) {
      console.error("Shorten links failed:", e);
      return urlsArray;
    }
  };

  // links milte hi (paste / PPD load / generate) background me short link taiyar rakho
  useEffect(() => {
    if (!settings.shortenTgLinks) return;
    const h = setTimeout(() => {
      [dbDownloadLinks, downloadLinksText].forEach(txt => {
        const arr = typeof txt === "string" ? txt.split("\n").map(l => l.trim()).filter(Boolean) : [];
        if (!arr.length) return;
        const main = arr[0];
        const mir = settings.singleTgLink ? arr[0] : (arr[1] || arr[0]);
        slPrefetch([main, mir], [settings.tgMainShortener, settings.tgMirrorShortener]);
      });
    }, 700);
    return () => clearTimeout(h);
  }, [dbDownloadLinks, downloadLinksText, settings.shortenTgLinks, settings.singleTgLink, settings.tgMainShortener, settings.tgMirrorShortener]);

  const warmShortLinks = async (linkTexts) => {
    if (!settings.shortenTgLinks) return;
    const tasks = (linkTexts || []).map(txt => () => {
      const arr = typeof txt === "string" ? txt.split("\n").map(l => l.trim()).filter(Boolean) : [];
      if (!arr.length) return Promise.resolve();
      const main = arr[0];
      const mir = settings.singleTgLink ? arr[0] : (arr[1] || arr[0]);
      return Promise.all([slFetchOne(main, settings.tgMainShortener), slFetchOne(mir, settings.tgMirrorShortener)]);
    });
    for (let i = 0; i < tasks.length; i += 3) { await Promise.all(tasks.slice(i, i + 3).map(f => f())); }
  };

  const warmPlayStore = async (ids) => {
    const list = Array.from(new Set((ids || []).filter(Boolean))).slice(0, 10);
    for (let i = 0; i < list.length; i += 3) {
      await Promise.all(list.slice(i, i + 3).map(id => fetch("/api/db", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ action: "fetch_playstore", appId: id }) }).catch(() => null)));
    }
  };

  // Extract existing TG links (works for 👑 VIP Link + 🔗 Main/Mirror/HostName links)
  const extractExistingTgLinks = (tgText) => {
    if (!tgText) return { vipUrl: "", mainUrl: "", mirrorUrl: "" };
    const vipMatch = tgText.match(/👑\s*[^:\n]+:\s*(https?:\/\/[^\s\n]+)/i);
    const matches = [...tgText.matchAll(/🔗\s*[^:\n]+:\s*(https?:\/\/[^\s\n]+)/gi)];
    return {
      vipUrl: vipMatch ? vipMatch[1].trim() : "",
      mainUrl: matches[0] ? matches[0][1].trim() : "",
      mirrorUrl: matches[1] ? matches[1][1].trim() : ""
    };
  };

  // Replace TG links line cleanly with 👑 VIP Link FIRST (when enabled) followed by Main & Mirror links
  const replaceTgLinksLine = (tgText, mainLabel, mainUrl, mirrorLabel, mirrorUrl, vipUrl = "", includeVip = false) => {
    if (!tgText) return "";
    const finalMain = mainUrl || "https://example.com";
    const finalMirror = mirrorUrl || "https://example.com";
    const cleanVip = (vipUrl || "").trim();
    const vipPrefix = (includeVip && cleanVip) ? `👑 VIP Link: ${cleanVip}   ` : "";
    const newLine = `${vipPrefix}🔗 ${mainLabel}: ${finalMain}   🔗 ${mirrorLabel}: ${finalMirror}`;

    const linkLineRegex = /^(?:👑\s*[^:\n]+:\s*\S+\s+)?🔗\s*[^:\n]+:.*$/m;
    if (linkLineRegex.test(tgText)) {
      return tgText.replace(linkLineRegex, newLine);
    }
    return `${tgText.trim()}\n${newLine}`;
  };

  // --- STRICT BBCODE SPACING SANITIZER ---
  const sanitizeBBCodeSpacing = (bb) => {
    if (!bb) return "";
    let cleaned = bb.replace(/\r\n/g, '\n');

    // 1. Modifications aur What's New ke beech keval 1 empty line
    cleaned = cleaned.replace(/(\[\/color\]\[\/b\])[ \t]*\n+(\[u\]What's New:\[\/u\])/i, '$1\n\n$2');

    // 2. What's New ke turant baad changelog (bina gap ke), aur changelog ke baad keval 1 empty line phir Credit text
    cleaned = cleaned.replace(/\[u\]What's New:\[\/u\][ \t]*\n*([\s\S]*?)\s*(\[b\]This app has credit[^\n]*)/i, (match, chlog, credit) => {
        return `[u]What's New:[/u]\n${chlog.trim()}\n\n${credit.trim()}`;
    });

    // 3. Credit text ke baad keval 1 empty line phir More Info
    cleaned = cleaned.replace(/(\[b\]This app has credit[^\n]*\[\/b\])[ \t]*\n+(\[u\]More Info:\[\/u\])/i, '$1\n\n$2');

    // 4. More Info, [code], aur Download Instructions ke beech koi empty line nahi
    cleaned = cleaned.replace(/\[u\]More Info:\[\/u\][ \t]*\n*(\[code\][\s\S]*?\[\/code\])[ \t]*\n*\[u\]Download Instructions:\[\/u\]/i, `[u]More Info:[/u]\n$1\n[u]Download Instructions:[/u]`);

    // 5. Download Instructions -> Main Link -> 1 empty line -> Mirror: -> Mirror Links (bina gap) -> 1 empty line -> Trouble downloading?
    cleaned = cleaned.replace(/\[u\]Download Instructions:\[\/u\][ \t]*\n*([\s\S]*?)\s*(Trouble downloading\?)/i, (match, middle, trouble) => {
        let parts = middle.split(/Mirror:[ \t]*/i);
        let mainLinks = (parts[0] || "").split('\n').map(l => l.trim()).filter(Boolean).join('\n');
        let mirrorLinks = parts.length > 1 ? parts.slice(1).join('\n').split('\n').map(l => l.trim()).filter(Boolean).join('\n') : "";

        let res = `[u]Download Instructions:[/u]\n${mainLinks}`;
        if (mirrorLinks) {
            res += `\n\nMirror:\n${mirrorLinks}`;
        } else if (middle.match(/Mirror:/i)) {
            res += `\n\nMirror:`;
        }
        res += `\n\n${trouble}`;
        return res;
    });

    // koi bhi jagah 1 se zyada empty line nahi: 2-3-4... empty lines => sirf 1
    cleaned = cleaned.replace(/[ \t]+\n/g, '\n').replace(/\n{3,}/g, '\n\n');

    return cleaned;
  };

  // --- INSTANT + BACKGROUND DOUBLE-SAFE CACHE SYNC ---
  const syncAppInLocalCache = (updatedApp) => {
    setDbAppList(prev => {
        if (!prev || prev.length === 0) return prev;
        const idx = prev.findIndex(item => (item.appId || "").toLowerCase() === (updatedApp.appId || "").toLowerCase());
        if (idx !== -1) {
            const copy = [...prev];
            copy[idx] = { ...copy[idx], ...updatedApp };
            return copy;
        }
        return [updatedApp, ...prev];
    });
  };

  // --- PPD BULK PASTE & DB SYNC ENGINE ---
  const [ppdRawText, setPpdRawText] = useState("");
  const [ppdSyncedList, setPpdSyncedList] = useState([]);
  const [isSyncingPpd, setIsSyncingPpd] = useState(false);
  const [ppdProcessedIds, setPpdProcessedIds] = useState([]);
  const [ppdCompletedIds, setPpdCompletedIds] = useState([]);
  const [ppdSyncTime, setPpdSyncTime] = useState("");
  const [ppdShowPendingOnly, setPpdShowPendingOnly] = useState(false);
  const [ppdCopiedPkg, setPpdCopiedPkg] = useState("");
  const [ppdPendingSize, setPpdPendingSize] = useState("");

  const markPpdOpened = (pkgId) => {
    if (!pkgId) return;
    setPpdProcessedIds(prev => {
      const next = prev.includes(pkgId) ? prev : [...prev, pkgId];
      try { localStorage.setItem("savedPpdProcessedIds", JSON.stringify(next)); } catch(e) {}
      return next;
    });
  };

  const markPpdCompleted = (pkgId) => {
    if (!pkgId) return;
    setPpdCompletedIds(prev => {
      const next = prev.includes(pkgId) ? prev : [...prev, pkgId];
      try { localStorage.setItem("savedPpdCompletedIds", JSON.stringify(next)); } catch(e) {}
      return next;
    });
  };

  // Supports 2, 3, 4, 5+ links in exact pasted order & preserves full APK filename for File Manager A-Z sorting
  function parsePpdBulkText(text) {
    if (!text || !text.trim()) return [];
    const lines = text.replace(/\r\n/g, "\n").split("\n").map(l => l.trim()).filter(Boolean);
    const items = [];
    let current = null;

    for (const line of lines) {
      if (/^https?:\/\//i.test(line)) {
        if (current) {
          current.allLinks.push(line);
        }
      } else {
        const sizeMatch = line.match(/\[\s*([\d.]+)\s*MB\s*\]/i);
        const sizeMB = sizeMatch ? sizeMatch[1] : "";
        const cleanFileNameOnly = line
          .replace(/^\d+\.\s*/, "")
          .replace(/\s*\[\s*[\d.]+\s*MB\s*\]/i, "")
          .trim();
        const cleanHeader = cleanFileNameOnly.replace(/\.apk$/i, "").trim();

        const pkgMatch = cleanHeader.match(/^([a-zA-Z0-9._]+?)[\s_]+v(?:t\.)?(\d[\d.a-zA-Z-]*)/i);
        const packageId = pkgMatch ? pkgMatch[1].trim() : cleanHeader.split(/[\s_]+/)[0].trim();
        const version = pkgMatch ? pkgMatch[2].trim() : "";

        if (packageId) {
          current = {
            rawHeader: line,
            cleanFileName: cleanFileNameOnly.endsWith(".apk") ? cleanFileNameOnly : `${cleanHeader}.apk`,
            packageId,
            version,
            sizeMB,
            allLinks: []
          };
          items.push(current);
        }
      }
    }
    return items.filter(it => it.packageId && it.allLinks.length > 0);
  }

  // Trigger automatic VIP sequence rebuild when PPD text, Sort Mode, or Custom Sequence text changes
  const refreshVipSequenceAndMap = (nextPpdText, nextSortMode, nextCustomSeq, nextBaseLink) => {
    const ordered = buildOrderedVipSequence(nextPpdText, nextSortMode, nextCustomSeq);
    setVipOrderedItems(ordered);
    try { localStorage.setItem("savedVipOrderedItems", JSON.stringify(ordered)); } catch (e) {}

    const newMap = recomputeVipMapFromOrder(ordered, nextBaseLink);
    setVipLinksMap(newMap);
    try { localStorage.setItem("savedVipLinksMap", JSON.stringify(newMap)); } catch (e) {}
    return { ordered, newMap };
  };

  const handleBulkSyncPpdToDb = async () => {
    const parsedItems = parsePpdBulkText(ppdRawText);
    if (parsedItems.length === 0) {
      return alert("Please paste valid PPD list (PackageID vX.X.X Mod.apk [MB] + Links)!");
    }

    // Ensure VIP sequence map is fresh (respects any manual ▲/▼ slide adjustments if count matches)
    let activeMap = vipLinksMap;
    if (vipBaseLink.trim()) {
      const currentOrdered = vipOrderedItems.length > 0 ? vipOrderedItems : buildOrderedVipSequence(ppdRawText, vipSortMode, vipCustomSeqText);
      activeMap = recomputeVipMapFromOrder(currentOrdered, vipBaseLink);
      setVipLinksMap(activeMap);
      localStorage.setItem("savedVipLinksMap", JSON.stringify(activeMap));
    }

    const itemsWithVip = parsedItems.map(it => ({
      ...it,
      vipLink: activeMap[it.packageId.toLowerCase()] || ""
    }));

    setIsSyncingPpd(true);
    try {
      const res = await fetch("/api/db", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "bulk_sync_ppd",
          items: itemsWithVip,
          singleTgLink: settings.singleTgLink,
          enableVipTgLink: settings.enableVipTgLink
        })
      });
      const data = await res.json();
      if (data.success && Array.isArray(data.results)) {
        const nowStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        setPpdSyncedList(data.results);
        setPpdProcessedIds([]);
        setPpdCompletedIds([]);
        setPpdSyncTime(nowStr);

        localStorage.setItem("savedPpdSyncedList", JSON.stringify(data.results));
        localStorage.setItem("savedPpdRawText", ppdRawText);
        localStorage.setItem("savedPpdProcessedIds", JSON.stringify([]));
        localStorage.setItem("savedPpdCompletedIds", JSON.stringify([]));
        localStorage.setItem("savedPpdSyncTime", nowStr);

        if (settings.localCache) {
          data.results.forEach(r => {
            if (r.inDb && r.appDataObj) syncAppInLocalCache(r.appDataObj);
          });
        }
        setTgToast(`✅ ${data.updatedCount}/${data.totalCount} Apps Updated in DB!`);
        setTimeout(() => setTgToast(""), 3000);
        const dupItems = data.results.filter(r => r.dupVersion);
        if (dupItems.length > 0) {
          const dupMsg = `⚠️ Duplicate upload detected!\n\n${dupItems.map(d => `• ${d.appName} v${d.version}`).join('\n')}\n\nThis version is already in DB. Add a new build code (e.g. b124) before applying.`;
          setTimeout(() => alert(dupMsg), 60);
        }
        try {
          warmShortLinks(data.results.map(r => r.linksText));
          warmPlayStore(data.results.filter(r => r.inDb !== false).map(r => r.packageId));
        } catch (e) {}
      } else {
        alert("Sync Error: " + (data.error || "Failed to sync with DB"));
      }
    } catch (err) {
      alert("Network Error: " + err.message);
    }
    setIsSyncingPpd(false);
  };

  const openPpdItemInDbUpdate = (item) => {
    if (!item || !item.appDataObj) return;
    markPpdOpened(item.packageId);
    setUpdateSearch(item.appName || item.packageId);
    const assignedVip = item.vipLink || getVipLinkForPkg(item.packageId);
    processLoadedApp(item.appDataObj, item.linksText, item.sizeMB, assignedVip);
    setActiveMainTab("database");
    setDbSubTab("form");
  };

  const openPpdItemInGenerate = (item) => {
    if (!item) return;
    markPpdOpened(item.packageId);
    setLink(item.packageId);
    if (item.linksText) {
      setDownloadLinksText(item.linksText);
      localStorage.setItem("savedDownloadLinksText", item.linksText);
    }
    if (item.sizeMB) {
      setPpdPendingSize(item.sizeMB);
    }
    const assignedVip = item.vipLink || getVipLinkForPkg(item.packageId);
    setGenVipLink(assignedVip || "");
    setActiveMainTab("generate");
  };

  useEffect(() => {
    const savedLinksText = localStorage.getItem("savedDownloadLinksText");
    if(savedLinksText) { try { setDownloadLinksText(savedLinksText); } catch(e) {} }

    const savedPpdText = localStorage.getItem("savedPpdRawText");
    if(savedPpdText) { try { setPpdRawText(savedPpdText); } catch(e) {} }

    const savedPpdResults = localStorage.getItem("savedPpdSyncedList");
    if(savedPpdResults) { try { setPpdSyncedList(JSON.parse(savedPpdResults)); } catch(e) {} }

    const savedProc = localStorage.getItem("savedPpdProcessedIds");
    if(savedProc) { try { setPpdProcessedIds(JSON.parse(savedProc)); } catch(e) {} }

    const savedComp = localStorage.getItem("savedPpdCompletedIds");
    if(savedComp) { try { setPpdCompletedIds(JSON.parse(savedComp)); } catch(e) {} }

    const savedTime = localStorage.getItem("savedPpdSyncTime");
    if(savedTime) { setPpdSyncTime(savedTime); }

    const sVipBase = localStorage.getItem("savedVipBaseLink");
    if (sVipBase) setVipBaseLink(sVipBase);

    const sVipSort = localStorage.getItem("savedVipSortMode");
    if (sVipSort) setVipSortMode(sVipSort);

    const sVipCustom = localStorage.getItem("savedVipCustomSeqText");
    if (sVipCustom) setVipCustomSeqText(sVipCustom);

    const sVipOrder = localStorage.getItem("savedVipOrderedItems");
    if (sVipOrder) { try { setVipOrderedItems(JSON.parse(sVipOrder)); } catch (e) {} }

    const sVipMap = localStorage.getItem("savedVipLinksMap");
    if (sVipMap) { try { setVipLinksMap(JSON.parse(sVipMap)); } catch (e) {} }
    
    const savedSettings = localStorage.getItem("mobilismSettingsProV4"); 
    if(savedSettings) {
        let pSet = null;
        try { pSet = JSON.parse(savedSettings); } catch (e) {}
        if (!pSet || typeof pSet !== 'object') pSet = { ...settings };
        if (pSet.localCache === undefined) pSet.localCache = false;
        if (pSet.enablePpdUpload === undefined) pSet.enablePpdUpload = false;
        if (pSet.singleTgLink === undefined) pSet.singleTgLink = false;
        if (pSet.dbAutoCopy === undefined) pSet.dbAutoCopy = true;
        if (pSet.dbAutoTg === undefined) pSet.dbAutoTg = false;
        if (pSet.autoFetchPlayStore === undefined) pSet.autoFetchPlayStore = false;
        if (pSet.showMiniQueue === undefined) pSet.showMiniQueue = true;
        if (pSet.miniQueuePosition === undefined) pSet.miniQueuePosition = 'top';
        if (pSet.shortenTgLinks === undefined) pSet.shortenTgLinks = false;
        if (pSet.tgMainShortener === undefined) pSet.tgMainShortener = 'shortxlinks';
        if (pSet.tgMirrorShortener === undefined) pSet.tgMirrorShortener = 'vipshort';
        if (pSet.useHostNameInTg === undefined) pSet.useHostNameInTg = false;
        if (pSet.enableVipTgLink === undefined) pSet.enableVipTgLink = false;
        if (pSet.autoEditVipApk === undefined) pSet.autoEditVipApk = false;
        if (pSet.vipIncludeDesc === undefined) pSet.vipIncludeDesc = true;
        setSettings(pSet);
    }
  }, []);

  useEffect(() => {
    const checkTheme = () => {
      if (settings.theme === 'dark') return true;
      if (settings.theme === 'light') return false;
      return window.matchMedia('(prefers-color-scheme: dark)').matches;
    };
    setIsDarkTheme(checkTheme());
    const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
    const handleChange = () => { if (settings.theme === 'auto') setIsDarkTheme(checkTheme()); };
    mediaQuery.addEventListener('change', handleChange);
    return () => mediaQuery.removeEventListener('change', handleChange);
  }, [settings.theme]);

  const updateSetting = (k, v) => {
    setSettings(prev => {
      const newSet = { ...prev, [k]: v };
      localStorage.setItem("mobilismSettingsProV4", JSON.stringify(newSet));
      return newSet;
    });
  };

  const swapShortenerOrder = () => {
    setSettings(prev => {
      const newSet = {
        ...prev,
        tgMainShortener: prev.tgMirrorShortener,
        tgMirrorShortener: prev.tgMainShortener
      };
      localStorage.setItem("mobilismSettingsProV4", JSON.stringify(newSet));
      return newSet;
    });
  };

  const updateCustomFormat = (k, v) => setCustomFormat({ ...customFormat, [k]: v });
  
  const handleArrChange = (arr, setArr, idx, val, saveKey) => {
    const n = [...arr]; n[idx] = val; setArr(n);
    if(saveKey) localStorage.setItem(saveKey, JSON.stringify(n));
  };
  const addArrField = (arr, setArr, saveKey) => {
    const n = [...arr, ""]; setArr(n); 
    if(saveKey) localStorage.setItem(saveKey, JSON.stringify(n));
  };
  const rmArrField = (arr, setArr, idx, saveKey) => {
    const n = arr.filter((_, i) => i !== idx); if(n.length<1) n.push(""); setArr(n);
    if(saveKey) localStorage.setItem(saveKey, JSON.stringify(n));
  };

  const resolveImageUrl = (obj) => { if (!obj) return ""; return typeof obj === 'string' ? obj : (obj[settings.imageQuality] || obj.original); };

  const handleBBCodePaste = (e) => {
    const text = e.target.value;
    setImportBBCode(text);
    const idMatch = text.match(/id=([a-zA-Z0-9._]+)/);
    if(idMatch && !importAppId) setImportAppId(idMatch[1]);
    const titleMatch = text.match(/\[b\](.*?)\[\/b\]/i);
    if(titleMatch) {
       const full = titleMatch[1];
       const tpImp = parseTitleParts(full);
       if(tpImp.version && !importVersion) setImportVersion(tpImp.version);
       if(!importAppName) setImportAppName((tpImp.name || full).replace(/\[.*?\]/g, '').trim());
    }
  };

  const extractLinksFromBBCode = (bbcode) => {
     const links = [];
     const instMatch = (bbcode || "").match(/\[u\]Download Instructions:\[\/u\][ \t]*\n+(https?:\/\/[^\s]+)/i);
     if(instMatch) links.push(instMatch[1]);
     const mirrorBlock = (bbcode || "").match(/Mirror:[ \t]*\n+([\s\S]*?)(\n\n|Trouble downloading\?|$)/i);
     if(mirrorBlock) {
         const mLinks = mirrorBlock[1].match(/(https?:\/\/[^\s]+)/g);
         if(mLinks) links.push(...mLinks);
     }
     return links;
  };

  const generateTgFromBBCode = (bbcode, title, version, shortOverview, vipUrlOverride = "") => {
     const tpTg = parseTitleParts(title);
     let cleanTitle = tpTg.name || title;
     const tgTierName = tpTg.tier ? tpTg.tier.replace(/^\[|\]$/g, '') : "Premium";
     const tgBuildPart = tpTg.build ? ` ${tpTg.build}` : "";
     let links = extractLinksFromBBCode(bbcode);
     let mainLink = links[0] || '';
     let mirrorLink = links[1] || '';

     const mLabel = settings.useHostNameInTg ? detectFileHostName(mainLink, "Main Link") : "Main Link";
     const mirLabel = settings.useHostNameInTg
       ? detectFileHostName(settings.singleTgLink ? mainLink : mirrorLink, "Mirror Link")
       : "Mirror Link";

     const vipPrefix = (settings.enableVipTgLink && vipUrlOverride) ? `👑 VIP Link: ${vipUrlOverride}   ` : "";
     let tgLinks = `${vipPrefix}🔗 ${mLabel}: ${mainLink}   🔗 ${mirLabel}: ${settings.singleTgLink ? mainLink : mirrorLink}`;

     return `🔥 ${cleanTitle}\n♻️ v${String(version || tpTg.version || "").replace(/^v(?=\d)/i, "")}${tgBuildPart} (${tgTierName})\n---------------------------------------------\n💁 ${shortOverview}\n\n⚙ **Modifications:**\n✪ Premium features unlocked;\n✪ CPUs: armeabi-v7a, arm64-v8a;\n---------------------------------------------\n📥 Download This Mod APK [MB]\n${tgLinks.trim()}`;
  };

  // --- SMART TG SHORT OVERVIEW VERIFIER & UPDATER ---
  // Only adds if missing, or updates if it has "Awesome application." — NEVER touches valid descriptions!
  const isTgOverviewMissingOrPlaceholder = (tgText) => {
     if (!tgText || !tgText.trim() || tgText.includes("⏳ Generating")) return true;
     if (/💁\s*Awesome application\.?/i.test(tgText)) return true;
     if (/^💁\s*$/m.test(tgText)) return true;
     if (!/💁\s*\S+/m.test(tgText)) return true;
     return false;
  };

  const verifyAndUpdateTgOverview = (existingTgText, fetchedOverview, bbCodeFallback, titleFallback, versionFallback) => {
     const cleanOverview = (fetchedOverview || "").trim();
     if (!cleanOverview || /^Awesome application\.?$/i.test(cleanOverview)) {
         return existingTgText;
     }

     // Case 1: TG text is empty or waiting -> generate full TG post with fetchedOverview
     if (!existingTgText || !existingTgText.trim() || existingTgText.includes("⏳ Generating")) {
         if (bbCodeFallback) {
             return generateTgFromBBCode(bbCodeFallback, titleFallback || "App", versionFallback || "", cleanOverview, dbVipLink);
         }
         return existingTgText;
     }

     // Case 2: TG text has "Awesome application." or empty "💁" -> replace ONLY the "💁 ..." line
     if (/💁\s*Awesome application\.?/i.test(existingTgText) || /^💁\s*$/m.test(existingTgText)) {
         return existingTgText.replace(/^💁\s*.*$/m, `💁 ${cleanOverview}`);
     }

     // Case 3: Already has a real short description -> do NOT touch!
     return existingTgText;
  };

  const fetchAllCache = async () => {
    setIsCaching(true);
    try {
        const res = await fetch("/api/db", {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: 'fetch_all_db' })
        });
        const data = await res.json();
        if (data.success) {
            setDbAppList(data.data);
        }
    } catch(e) { console.log(e); }
    setIsCaching(false);
  };

  useEffect(() => {
    if (settings.localCache && dbAppList.length === 0) {
        fetchAllCache();
    }
  }, [settings.localCache]);

  const filteredApps = dbAppList.filter(app => 
      (app.appName || "").toLowerCase().includes((updateSearch || "").toLowerCase()) || 
      (app.appId || "").toLowerCase().includes((updateSearch || "").toLowerCase())
  ).slice(0, 20); 

  // --- FORMAT VIP APK CAPTION HTML (WITH HALF DIVIDER LINE & OPTIONAL DESCRIPTION) ---
  const formatVipApkCaptionHtml = (plainTgText, appPlayUrl, includeDesc = settings.vipIncludeDesc) => {
    if (!plainTgText) return "";

    const escapeHtml = (str) => String(str || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    const titleMatch = plainTgText.match(/^🔥\s+(.+)$/m);
    const verMatch   = plainTgText.match(/^♻️\s+(.+)$/m);
    const descMatch  = plainTgText.match(/^💁\s+(.+)$/m);

    const rawTitle = titleMatch ? titleMatch[1].trim() : (activeMainTab === 'database' ? dbAppName : appName) || "App";
    const rawVer   = verMatch
      ? verMatch[1].replace(/[ \t]*#FirstTimeOnNet/gi, "").trim()
      : `v${(activeMainTab === 'database' ? dbVersion : appVersion) || "1.0"} (Premium)`;
    const rawDesc  = descMatch ? descMatch[1].trim() : "";

    const safeTitle = escapeHtml(rawTitle);
    const safeVer   = escapeHtml(rawVer);
    const safeDesc  = escapeHtml(rawDesc);

    const titleLineHtml = appPlayUrl
      ? `🔥 <b><a href="${appPlayUrl}">${safeTitle}</a></b>`
      : `🔥 <b>${safeTitle}</b>`;

    const verLineHtml = `♻️ ${safeVer}`;

    // Half-length divider line (22 dashes instead of 45) + Description when enabled
    if (includeDesc && safeDesc) {
      return `${titleLineHtml}\n${verLineHtml}\n----------------------------------\n💁 ${safeDesc}`;
    }

    // When Description is OFF: only Title (with PlayStore link) + Version!
    return `${titleLineHtml}\n${verLineHtml}`;
  };

  // --- BACKGROUND / MANUAL VIP CHANNEL APK CAPTION EDITOR ---
  const handleEditVipChannelApk = (overrideVipLink = null, overrideTgText = null, silentBackground = false) => {
    const currentTgText = typeof overrideTgText === 'string'
      ? overrideTgText
      : (activeMainTab === 'database' ? dbTelegramResult : telegramResult);

    const existingExtracted = extractExistingTgLinks(currentTgText);
    const currentVipUrl = (
      (typeof overrideVipLink === 'string' ? overrideVipLink : "") ||
      (activeMainTab === 'database' ? (dbVipLink || getVipLinkForPkg(dbAppId)) : (genVipLink || getVipLinkForPkg(playStoreUrl || link))) ||
      existingExtracted.vipUrl ||
      ""
    ).trim();

    if (!currentVipUrl) {
      if (!silentBackground) alert("VIP APK Link nahi mila! Pehle VIP Link daalein ya Sequence sync karein.");
      return;
    }
    if (!currentTgText) {
      if (!silentBackground) alert("TG Post data nahi mila!");
      return;
    }

    const targetPlayUrl = playStoreUrl || (dbAppId ? `https://play.google.com/store/apps/details?id=${dbAppId}` : "");
    const vipCaptionHtml = formatVipApkCaptionHtml(currentTgText, targetPlayUrl, settings.vipIncludeDesc);

    setIsEditingVip(true);
    fetch("/api/send-to-tg", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      keepalive: true,
      body: JSON.stringify({
        action: "edit_vip_only",
        vipLink: currentVipUrl,
        vipCaption: vipCaptionHtml
      })
    })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          setTgToast(`✅ VIP APK #${data.messageId || ""} Caption Edited!`);
          setTimeout(() => setTgToast(""), 3000);
        } else {
          console.error("VIP Edit Error:", data.error);
          setTgToast(`❌ VIP Edit Failed: ${data.error || "Error"}`);
          setTimeout(() => setTgToast(""), 3500);
        }
      })
      .catch(err => {
        console.error("VIP Edit Network Error:", err);
        setTgToast("❌ VIP Edit Network Error");
        setTimeout(() => setTgToast(""), 3000);
      })
      .finally(() => {
        setIsEditingVip(false);
      });
  };

  const applyLinksToTemplates = async () => {
       if(!dbResult && !dbTelegramResult) return;

       // RED WARNING CHECK FOR EMPTY SIZE BOX (Tap again to bypass)
       if (!dbAppSize.trim() && !sizeWarning) {
           setSizeWarning(true);
           return;
       }
       setSizeWarning(false);
       setApplySuccess(false);
       
       let updatedBB = dbResult || ""; 
       let updatedTG = dbTelegramResult || "";
       
       const cleanLinks = typeof dbDownloadLinks === 'string' ? dbDownloadLinks.split('\n').map(l => l.trim()).filter(l => l !== '') : [];
       const mainL = cleanLinks[0] || '';
       const mirrors = cleanLinks.length > 1 ? cleanLinks.slice(1) : [];
       const firstMirror = mirrors[0] || '';

       let finalTitle = dbAppTitle;
       const tpApply = parseTitleParts(dbAppTitle);
       const applyBuild = normalizeBuild(dbBuild);
       const applyVer = String(dbVersion || "").trim().replace(/^v(?=\d)/i, "");
       if (finalTitle) {
           if (applyVer || tpApply.hasVersion) {
               finalTitle = composeTitle({
                   name: tpApply.name, prefix: tpApply.prefix || "v",
                   version: applyVer || tpApply.version, build: applyBuild,
                   extra: tpApply.extra, tier: tpApply.tier, tag: tpApply.tag
               });
           }
           setDbAppTitle(finalTitle);
       }
       setDbBuild(applyBuild);
       if (!applyBuild) setShowBuildBox(false);
       setDupWarn(false);

       // ======== BBCODE UPDATES (100% ORIGINAL LINKS) ========
       if (finalTitle) {
           if (updatedBB) updatedBB = updatedBB.replace(/^\[b\].*?\[\/b\]/im, () => `[b]${finalTitle}[/b]`);
           setPostTitle(finalTitle);

           const justName = tpApply.name || finalTitle;
           if (updatedTG) {
               updatedTG = updatedTG.replace(/^🔥\s+.*?$/m, () => `🔥 ${justName}`);
           }
           if (tpApply.name) setDbAppName(tpApply.name);
       }

       if (updatedTG && (applyVer || tpApply.hasVersion)) {
           updatedTG = updateTgVersionLine(updatedTG, { version: applyVer || tpApply.version, build: applyBuild, tier: tpApply.tier, prefix: tpApply.prefix });
       }

       if (dbReqText && updatedBB) {
           let cleanReq = dbReqText.replace(/^Android\s*/i, '').trim();
           updatedBB = updatedBB.replace(/(\[u\]Requirements:\[\/u\][ \t]*)[^\n]+/i, `$1Android ${cleanReq}`);
       }

       if (dbChangelog && updatedBB) {
           updatedBB = updatedBB.replace(/\[u\]What's New:\[\/u\][ \t]*\n*[\s\S]*?(?=\[b\]This app has credit|\[u\]More Info)/i, `[u]What's New:[/u]\n${dbChangelog.trim()}\n\n`); 
       }

       if (dbModifications && updatedBB) {
           const cleanModsText = dbModifications.replace(/[ \t]*#FirstTimeOnNet/gi, "").trim();
           setDbModifications(cleanModsText);
           const modRegex = /\[b\]\[color=#?[a-zA-Z0-9]+\]Modifications:\s*\n[\s\S]*?\[\/color\]\[\/b\]/i;
           if (updatedBB.match(modRegex)) {
               if (cleanModsText.startsWith('[b]')) {
                   updatedBB = updatedBB.replace(modRegex, cleanModsText);
               } else {
                   const fbRegex = /Modifications:\s*\n[\s\S]*?TRUMods[^\n\[]*/i;
                   updatedBB = updatedBB.replace(fbRegex, cleanModsText);
               }
           } else {
               const fbRegex = /Modifications:\s*\n[\s\S]*?TRUMods[^\n\[]*/i;
               if(updatedBB.match(fbRegex)) {
                    updatedBB = updatedBB.replace(fbRegex, cleanModsText);
               }
           }
       }
       
       if (updatedBB) {
           if (mainL) {
               let linkSection = `${mainL}`;
               if (mirrors.length > 0) {
                   linkSection += `\n\nMirror:\n${mirrors.join('\n')}`;
               }
               updatedBB = updatedBB.replace(/\[u\]Download Instructions:\[\/u\][\s\S]*?(?=Trouble downloading\?)/i, `[u]Download Instructions:[/u]\n${linkSection}\n\n`);
           }
           // Remove #FirstTimeOnNet in DB Update mode & strictly enforce spacing
           updatedBB = updatedBB.replace(/[ \t]*#FirstTimeOnNet/gi, "");
           updatedBB = sanitizeBBCodeSpacing(updatedBB);
           setDbResult(updatedBB); 
       }

       // 1. INSTANT SWITCH TO CODE TAB & TG POST + 0ms AUTO DOUBLE CLIPBOARD COPY
       setDbSubTab("code");
       setActiveTab("telegram");

       if (settings.dbAutoCopy) {
           navigator.clipboard.writeText(updatedBB).then(() => {
               setTimeout(() => {
                   navigator.clipboard.writeText(finalTitle);
                   setCopiedTitleText(true);
                   setTimeout(() => setCopiedTitleText(false), 2000);
               }, 500);
           }).catch(err => console.log("Clipboard write failed", err));
       }

       // If TG post is missing or still has "Awesome application.", wait for background PlayStore fetch (or fetch now)
       if (dbAppId && isTgOverviewMissingOrPlaceholder(updatedTG)) {
           try {
               let psData = null;
               if (bgPlayStorePromiseRef.current) {
                   psData = await bgPlayStorePromiseRef.current;
               }
               if (!psData || !psData.fetchedOverview) {
                   const resPs = await fetch("/api/db", {
                       method: "POST", headers: { "Content-Type": "application/json" },
                       body: JSON.stringify({ action: 'fetch_playstore', appId: dbAppId })
                   });
                   psData = await resPs.json();
               }
               if (psData && psData.success && psData.fetchedOverview) {
                   updatedTG = verifyAndUpdateTgOverview(updatedTG, psData.fetchedOverview, updatedBB, finalTitle, dbVersion);
               }
           } catch (e) {}
       }

       // ======== TELEGRAM UPDATES (WITH 👑 VIP LINK FIRST + DUAL SHORTENER + AUTO HOST NAME) ========
       let resolvedFinalVipUrl = "";
       if (updatedTG) {
           updatedTG = updatedTG.replace(/[ \t]*#FirstTimeOnNet/gi, "");
           updatedTG = updatedTG.replace(/\[\s*[\d.]*\s*MB\s*\]/i, `[${dbAppSize ? dbAppSize + 'MB' : 'MB'}]`);
           updatedTG = updatedTG.replace(/⚙\s*\*?\*?Modifications:\*?\*?/i, '⚙ **Modifications:**');
           updatedTG = updatedTG.replace(/✪\s*.*?\s*\/?\s*Paid\s*features\s*unlocked;/gi, '✪ Premium features unlocked;');

           const bbExtractedLinks = extractLinksFromBBCode(updatedBB);
           const existingTgLinks = extractExistingTgLinks(updatedTG);

           const rawMainSource = mainL || bbExtractedLinks[0] || existingTgLinks.mainUrl;
           const rawMirrorSource = settings.singleTgLink
               ? rawMainSource
               : (firstMirror || bbExtractedLinks[1] || existingTgLinks.mirrorUrl || rawMainSource);

           const mainLabel = settings.useHostNameInTg
               ? detectFileHostName(rawMainSource, "Main Link")
               : "Main Link";
           const mirrorLabel = settings.useHostNameInTg
               ? detectFileHostName(rawMirrorSource, "Mirror Link")
               : "Mirror Link";

           let tgMainUrl = mainL || existingTgLinks.mainUrl || rawMainSource;
           let tgMirrorUrl = settings.singleTgLink
               ? (mainL || rawMainSource)
               : (firstMirror || existingTgLinks.mirrorUrl || rawMirrorSource);

           if (settings.shortenTgLinks && (rawMainSource || rawMirrorSource)) {
               const [shortMain, shortMirror] = await shortenUrlsForTg(
                   [rawMainSource, rawMirrorSource],
                   [settings.tgMainShortener, settings.tgMirrorShortener], lateTgPatch
               );
               if (shortMain) tgMainUrl = shortMain;
               if (shortMirror) tgMirrorUrl = shortMirror;
           } else if (!settings.shortenTgLinks) {
               tgMainUrl = rawMainSource;
               tgMirrorUrl = rawMirrorSource;
           }

           resolvedFinalVipUrl = (dbVipLink || getVipLinkForPkg(dbAppId) || existingTgLinks.vipUrl || "").trim();
           updatedTG = replaceTgLinksLine(updatedTG, mainLabel, tgMainUrl, mirrorLabel, tgMirrorUrl, resolvedFinalVipUrl, settings.enableVipTgLink);
           setDbTelegramResult(updatedTG);
       }

       // 3. AUTO SEND TO TELEGRAM &/OR AUTO EDIT VIP APK IN BACKGROUND
       if (settings.dbAutoTg && updatedTG) {
           handleSendToTelegram(updatedTG, resolvedFinalVipUrl);
       } else if (settings.autoEditVipApk && resolvedFinalVipUrl && updatedTG) {
           handleEditVipChannelApk(resolvedFinalVipUrl, updatedTG, true);
       }

       // 4. BACKGROUND DB SAVE + DOUBLE-SAFE CACHE SYNC
       if (dbAppId) {
           markPpdCompleted(dbAppId);
           const savedAppObj = {
               appId: dbAppId,
               appName: (tpApply.name || dbAppName || appName).replace(/_/g, ' '),
               version: dbVersion || appVersion,
               bbCode: updatedBB,
               tgCode: updatedTG,
               promoImage: headerImage ? headerImage.original : silentImage
           };
           if (settings.localCache) syncAppInLocalCache(savedAppObj);

           try {
               setSavingDb(true);
               await fetch("/api/db", {
                   method: "POST", headers: { "Content-Type": "application/json" },
                   keepalive: true,
                   body: JSON.stringify({ action: 'save', ...savedAppObj })
               });
               setSavedSuccess(true); setTimeout(() => setSavedSuccess(false), 2000);
               if (settings.localCache) fetchAllCache(); 
           } catch (err) {
               console.error("Auto DB Save failed:", err);
           } finally {
               setSavingDb(false);
           }
       }
  };

  const fetchData = async (actionType) => {
    if(!link) return alert("Please enter a Play Store URL!");
    setLoading(true); 
    if (actionType === 'both' || actionType === 'text_only') {
      setResult(""); setTelegramResult(""); setPostTitle(""); setActiveTab("code"); setIsCustomMenuOpen(false); setAppData(null);
    }
    if (actionType === 'both' || actionType === 'images_only' || actionType === 'text_only') {
      setScreenshots([]); setHeaderImage(null); setSilentImage(""); setAppVersion(""); setPlayStoreUrl(""); setAppIcon(""); 
    }
    try {
      const cleanLinksToSubmit = typeof downloadLinksText === 'string' ? downloadLinksText.split('\n').map(l => l.trim()).filter(l => l !== '') : [];

      const res = await fetch("/api/generate", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ link, images: customImages, downloadLinks: cleanLinksToSubmit, action: actionType }),
      });
      const data = await res.json();
      
      if(data.category) setAppCategory(data.category);
      if(data.appName) setAppName(data.appName);
      if(data.appVersion) setAppVersion(data.appVersion);
      if(data.playStoreUrl) setPlayStoreUrl(data.playStoreUrl);
      if(data.appIcon) setAppIcon(data.appIcon);
      if (actionType === 'images_only' || actionType === 'both') {
          if(data.screenshots) setScreenshots(data.screenshots);
          if(data.headerImage) setHeaderImage(data.headerImage);
      }
      if (actionType === 'text_only' || actionType === 'both') {
        if (data.template) {
          let finalBB = data.template;
          try { const builtBB = buildGenerateBB(data, customFormat); if (builtBB) finalBB = builtBB; } catch (e) {}
          finalBB = sanitizeBBCodeSpacing(finalBB);
          setResult(finalBB); 
          
          let finalTg = data.telegramTemplate || "";
          if (ppdPendingSize) {
              finalTg = finalTg.replace(/\[\s*[\d.]*\s*MB\s*\]/i, `[${ppdPendingSize}MB]`);
              setPpdPendingSize("");
          }

          const existingGenLinks = extractExistingTgLinks(finalTg);
          const rawMain = cleanLinksToSubmit[0] || existingGenLinks.mainUrl;
          const rawMir = settings.singleTgLink
              ? rawMain
              : (cleanLinksToSubmit[1] || existingGenLinks.mirrorUrl || rawMain);

          const mLabel = settings.useHostNameInTg ? detectFileHostName(rawMain, "Main Link") : "Main Link";
          const mirLabel = settings.useHostNameInTg ? detectFileHostName(rawMir, "Mirror Link") : "Mirror Link";

          let finalMainUrl = rawMain;
          let finalMirUrl = rawMir;

          if (settings.shortenTgLinks && (rawMain || rawMir)) {
              const [sMain, sMir] = await shortenUrlsForTg(
                  [rawMain, rawMir],
                  [settings.tgMainShortener, settings.tgMirrorShortener], lateTgPatch
              );
              if (sMain) finalMainUrl = sMain;
              if (sMir) finalMirUrl = sMir;
          }

          const resolvedVip = (genVipLink || getVipLinkForPkg(data.playStoreUrl || link) || "").trim();
          if (resolvedVip && !genVipLink) setGenVipLink(resolvedVip);

          finalTg = replaceTgLinksLine(finalTg, mLabel, finalMainUrl, mirLabel, finalMirUrl, resolvedVip, settings.enableVipTgLink);
          setTelegramResult(finalTg);

          setSilentImage(data.silentImageUrl); setPostTitle(data.postTitle); setAppData(data); 
          if (settings.autoCopyBBCode) { navigator.clipboard.writeText(finalBB); setCopiedCode(true); setTimeout(() => setCopiedCode(false), 2000); }
        } else { alert(data.error || "Failed to generate text."); }
      }
    } catch(err) { alert("Network Error: Try again!"); }
    setLoading(false);
  };

  const processLoadedApp = (appDataObj, customLinksText = null, customSizeMB = null, customVipLink = null) => {
         if (!appDataObj) return;
         setSizeWarning(false);
         setPlayStoreFetched(false);
         setVersionMismatch(false);
         setPsFetchedVersion("");

         // If this app is currently Pending in PPD Queue (not yet Applied/Completed), grab its synced Links, Size & VIP Link
         const pendingPpdItem = ppdSyncedList.find(
             it => (it.packageId || "").toLowerCase() === (appDataObj.appId || "").toLowerCase() &&
                   !ppdCompletedIds.includes(it.packageId)
         );
         if (pendingPpdItem) {
             if (pendingPpdItem.appDataObj) appDataObj = pendingPpdItem.appDataObj;
             if (customLinksText === null && pendingPpdItem.linksText) customLinksText = pendingPpdItem.linksText;
             if (customSizeMB === null && pendingPpdItem.sizeMB) customSizeMB = pendingPpdItem.sizeMB;
             if (customVipLink === null && pendingPpdItem.vipLink) customVipLink = pendingPpdItem.vipLink;
             markPpdOpened(pendingPpdItem.packageId);
         }

         let realTitle = appDataObj.appName || "App";
         // Clean #FirstTimeOnNet and any extra empty lines immediately when loading in DB Update
         let rawLoadedBB = (appDataObj.bbCode || "").replace(/[ \t]*#FirstTimeOnNet/gi, "");
         let bbCode = sanitizeBBCodeSpacing(rawLoadedBB);
         let extractedChangelog = "";
         let extractedReq = "";
         let extractedMods = "";
         let currentVersion = appDataObj.version || "";

         if (bbCode) {
             const titleMatch = bbCode.match(/^\[b\](.*?)\[\/b\]/im);
             if(titleMatch) realTitle = titleMatch[1]; 
             
             if (!currentVersion) {
                 const tpV = parseTitleParts(realTitle);
                 if (tpV.version) currentVersion = tpV.version;
             }
             
             const changelogMatch = bbCode.match(/\[u\]What's New:\[\/u\][ \t]*\n([\s\S]*?)(?=\n*\[b\]This app has credit|\n*\[u\]More Info|\n*\[b\]\[color)/i);
             if (changelogMatch) extractedChangelog = changelogMatch[1].trim();

             const reqMatch = bbCode.match(/\[u\]Requirements:\[\/u\]\s*(?:Android\s*)?([^\n]+)/i);
             if (reqMatch) extractedReq = reqMatch[1].trim();

             const modMatch = bbCode.match(/(\[b\]\[color=#?[a-zA-Z0-9]+\]Modifications:\s*\n[\s\S]*?\[\/color\]\[\/b\])/i);
             if (modMatch) {
                 extractedMods = modMatch[1].trim();
             } else {
                 const modFallback = bbCode.match(/(Modifications:\s*\n[\s\S]*?TRUMods[^\n\[]*)/i);
                 if (modFallback) extractedMods = modFallback[1].trim();
             }
         }
         const tpLoaded = parseTitleParts(realTitle);
         let cleanAppName = tpLoaded.name || realTitle;
         let loadedBuild = tpLoaded.build;

         let finalTgCode = (appDataObj.tgCode || "").replace(/[ \t]*#FirstTimeOnNet/gi, "");
         if (!loadedBuild && finalTgCode) {
             const mTgB = finalTgCode.match(/^♻\uFE0F?[ \t]*(.*)$/m);
             if (mTgB) loadedBuild = parseTitleParts(mTgB[1], true).build;
         }
         const existingTgExtracted = extractExistingTgLinks(finalTgCode);
         const resolvedVipLink = customVipLink || getVipLinkForPkg(appDataObj.appId) || existingTgExtracted.vipUrl || "";
         setDbVipLink(resolvedVipLink);

         if (!finalTgCode && bbCode) {
             finalTgCode = generateTgFromBBCode(bbCode, realTitle, currentVersion, "Awesome application.", resolvedVipLink); 
         }

         let sizeMatch = finalTgCode.match(/\[\s*([\d.]+)\s*MB\s*\]/i);
         setDbAppSize(customSizeMB || (sizeMatch ? sizeMatch[1] : ""));

         const initialLinks = customLinksText !== null ? customLinksText : "\n\n";

         setDbAppId(appDataObj.appId); 
         setDbAppName(cleanAppName); 
         setDbVersion(currentVersion);
         setDbBuild(loadedBuild || "");
         setShowBuildBox(!!loadedBuild);
         const isDupLoad = !!(pendingPpdItem && pendingPpdItem.dupVersion);
         setDupWarn(isDupLoad);
         if (isDupLoad) setShowBuildBox(true);
         setIsEditingTitle(false);
         setDbAppTitle(realTitle);
         setDbChangelog(extractedChangelog); 
         setDbModifications(extractedMods);
         setDbReqText(extractedReq);
         setDbDownloadLinks(initialLinks); 

         setDbResult(bbCode); 
         setDbTelegramResult(finalTgCode);
         setPlayStoreUrl(`https://play.google.com/store/apps/details?id=${appDataObj.appId}`);
         
         setAppName(cleanAppName); 
         setPostTitle(realTitle); 

         setOriginalDbData({
             title: realTitle, version: currentVersion, build: loadedBuild || "", changelog: extractedChangelog, 
             reqText: extractedReq, modifications: extractedMods, links: initialLinks, vipLink: resolvedVipLink
         });
         
         let imgUrl = appDataObj.promoImage;
         if(!imgUrl && bbCode) {
             const imgMatch = bbCode.match(/\[IMG\](.*?)\[\/IMG\]/i);
             if(imgMatch) imgUrl = imgMatch[1];
         }
         
         if(imgUrl && imgUrl.startsWith('http')) { 
             setHeaderImage({original: imgUrl}); 
             setSilentImage(imgUrl); 
         } else { 
             setHeaderImage(null); 
             setSilentImage(""); 
         }

         if (finalTgCode) {
             setDbTelegramResult(finalTgCode);
         } else if (bbCode) {
             setDbTelegramResult("⏳ Generating Telegram post in background...");
         } else {
             setDbTelegramResult("");
         }

         setUpdateLoading(false);
         setDbSubTab("form"); 

         // Auto Fetch or Background Info + TG Short Overview Verification Fetch
         if (settings.autoFetchPlayStore) {
             fetchLatestPlayStore(appDataObj.appId, realTitle, currentVersion, bbCode);
         } else {
             const bgPromise = fetch("/api/db", {
                 method: "POST", headers: { "Content-Type": "application/json" },
                 body: JSON.stringify({ action: 'fetch_playstore', appId: appDataObj.appId })
             }).then(resBg => resBg.json()).then(dataBg => {
                 if(dataBg.success) {
                     if ((!imgUrl || !imgUrl.startsWith('http')) && dataBg.fetchedHeaderImage) {
                         setHeaderImage(dataBg.fetchedHeaderImage);
                         setSilentImage(dataBg.fetchedHeaderImage.original);
                     }
                     // Verify & fix TG Short Overview if missing or "Awesome application."
                     if (dataBg.fetchedOverview) {
                         setDbTelegramResult(prevTg => verifyAndUpdateTgOverview(prevTg || finalTgCode, dataBg.fetchedOverview, bbCode, realTitle, currentVersion));
                     }
                 }
                 return dataBg;
             }).catch(err => {
                 console.log("Background fetch failed", err);
                 return null;
             });
             bgPlayStorePromiseRef.current = bgPromise;
         }
  };

