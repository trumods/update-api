                     updatedVerForTg = data.newVersion;
                     
                     let currentTitle = overrideTitle || dbAppTitle;
                     const curParts = parseTitleParts(currentTitle);
                     const currentTier = curParts.tier || "[Premium]";
                     const prevVerNorm = String(originalVersion || dbVersion || "").trim().replace(/^v(?=\d)/i, "");
                     const newVerClean = String(data.newVersion).trim().replace(/^v(?=\d)/i, "");
                     let keepBuild = overrideTitle ? curParts.build : normalizeBuild(dbBuild);
                     if (prevVerNorm && prevVerNorm !== newVerClean && keepBuild) {
                         setDbBuild(""); setShowBuildBox(false);
                         setTgToast(`ℹ️ Old build ${keepBuild} removed (new version)`);
                         setTimeout(() => setTgToast(""), 3000);
                         keepBuild = "";
