                     let psName = curParts.name;
                     if (data.title) {
                         const customSuffix = getCustomBracketSuffix(curParts.name, data.title);
                         psName = customSuffix ? `${data.title} ${customSuffix}` : data.title;
                     }
                     let newTitle = data.title
                         ? composeTitle({ name: psName, prefix: curParts.prefix || "v", version: newVerClean, build: keepBuild, extra: curParts.extra, tier: currentTier, tag: curParts.tag })
                         : currentTitle;
                     setDbAppTitle(newTitle);
                     if (data.title) setDbAppName(psName);
                     updatedTitleForTg = newTitle;
                 }

                 if (data.reqText && data.reqText !== 'Varies with device' && data.reqText !== 'Varies with device and up') {
                     setDbReqText(data.reqText);
                 }

                 setDbChangelog(data.formattedChangelog || "");

                 if(data.fetchedHeaderImage) { setHeaderImage(data.fetchedHeaderImage); setSilentImage(data.fetchedHeaderImage.original); }

                 // Verify & Fix TG Short Overview at the exact moment version/PlayStore is checked!
                 if (data.fetchedOverview) {
                     setDbTelegramResult(prevTg => verifyAndUpdateTgOverview(prevTg, data.fetchedOverview, overrideBBCode || dbResult, updatedTitleForTg, updatedVerForTg));
                 }
