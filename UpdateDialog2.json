    navigator.clipboard.writeText(cleanLink + (cleanLink.includes('?') ? '&ext=.png' : '?.png'));
    setCopiedLinkIdx(id); setTimeout(() => setCopiedLinkIdx(null), 1500); 
  };
  
  const uploadScreenshotToMobilism = async (urlObj, idx) => {
    if (!urlObj || uploadingIdx !== null) return;
    const imageUrl = resolveImageUrl(urlObj);
    setUploadingIdx(idx);

    try {
      // 1. Proxy se image laakar Canvas ke zariye PNG Blob me convert karna (WebP error se bachne ke liye)
      const proxyUrl = `/api/proxy-image?url=${encodeURIComponent(imageUrl)}`;
      const res = await fetch(proxyUrl);
      if (!res.ok) throw new Error("Image fetch failed");
      const blob = await res.blob();

      const pngBlob = await new Promise((resolve, reject) => {
        const img = new Image();
        const objectUrl = URL.createObjectURL(blob);
        img.onload = () => {
          const canvas = document.createElement("canvas");
          canvas.width = img.width;
          canvas.height = img.height;
          canvas.getContext("2d").drawImage(img, 0, 0);
          URL.revokeObjectURL(objectUrl);
          canvas.toBlob((b) => (b ? resolve(b) : reject(new Error("PNG conversion failed"))), "image/png");
        };
        img.onerror = () => {
          URL.revokeObjectURL(objectUrl);
          reject(new Error("Image load error"));
        };
        img.src = objectUrl;
      });

      // 2. Backend API (/api/upload-image) par bhejna
      const formData = new FormData();
      formData.append("file", pngBlob, `Screen_${idx + 1}.png`);

      const upRes = await fetch("/api/upload-image", {
        method: "POST",
        body: formData,
      });
      const data = await upRes.json();

      if (!upRes.ok || !data.success || !data.dmLink) {
        throw new Error(data.error || "Upload failed");
      }

      const dmUrl = data.dmLink;

      // 3. Custom Image Input Box me Auto-Fill karna (Khali box me daalna ya naya box banana)
      let updatedImagesList = [];
      setCustomImages((prev) => {
        const copy = [...prev];
        const emptyIndex = copy.findIndex((item) => !item || item.trim() === "");
        if (emptyIndex !== -1) {
          copy[emptyIndex] = dmUrl;
        } else {
          copy.push(dmUrl);
        }
        updatedImagesList = copy.filter((item) => item && item.trim() !== "");
        return copy;
      });

      // 4. Agar niche BBCode pehle se generated hai, to usme bhi live [IMG] tags update kar dena
      setResult((prevBB) => {
        if (!prevBB) return prevBB;
        const cleanImgs = updatedImagesList.length > 0 ? updatedImagesList : [dmUrl];
        let newImgBlock = `[IMG]${cleanImgs[0]}[/IMG] [break]`;
        if (cleanImgs.length > 1) {
          newImgBlock += ` ` + cleanImgs.slice(1).map((u) => `[IMG]${u}[/IMG]`).join(" ");
        }
        return prevBB.replace(/\[IMG\].*?\[\/IMG\]\s*\[break\](?:\s*\[IMG\].*?\[\/IMG\])*/i, newImgBlock);
      });

      setAppData((prevData) => (prevData ? { ...prevData, customImagesRaw: updatedImagesList } : prevData));
      setUploadedMap((prev) => ({ ...prev, [idx]: dmUrl }));
      setTgToast(`✅ Img ${idx + 1} Uploaded & Auto-Filled!`);
      setTimeout(() => setTgToast(""), 2500);
    } catch (err) {
      console.error(err);
      alert("Upload failed: " + err.message);
    } finally {
      setUploadingIdx(null);
    }
  };

  const parseBBCode = (text) => {
    if (!text) return "";
    return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\[b\](.*?)\[\/b\]/gis, '<strong>$1</strong>').replace(/\[i\](.*?)\[\/i\]/gis, '<em>$1</em>').replace(/\[u\](.*?)\[\/u\]/gis, '<u>$1</u>').replace(/\[color=(.*?)\](.*?)\[\/color\]/gis, '<span style="color:$1;">$2</span>').replace(/\[url=(https?:\/\/[^\]]*?)\](.*?)\[\/url\]/gis, '<a href="$1" target="_blank" style="color: #0ea5e9; text-decoration: underline;">$2</a>').replace(/\[code\](.*?)\[\/code\]/gis, '<pre style="background:rgba(0,0,0,0.5); padding:12px; border-radius:8px; overflow-x:auto; border:1px solid rgba(128,128,128,0.2);">$1</pre>').replace(/\[IMG\](.*?)\[\/IMG\]/gis, '<img src="$1" style="max-width:100%; border-radius:10px; margin: 10px 0;" onerror="this.style.display=\'none\'" />').replace(/\[break\]/gi, '<br/>').replace(/\n/g, '<br/>');
  };

  const formatTelegramHtml = (plainText) => {
    if (!plainText) return "";
    let html = plainText.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    html = html.replace(/\*\*(.*?)\*\*/g, '<b>$1</b>');

    if (playStoreUrl) {
       html = html.replace(/^🔥\s+(.+)$/m, `🔥 <b><a href="${playStoreUrl}">$1</a></b>`);
    } else {
       html = html.replace(/^🔥\s+(.+)$/m, `🔥 <b>$1</b>`);
    }

    // Converts 👑 VIP Link: https://... into clickable HTML link
    html = html.replace(/👑\s*([^:\n]+?)\s*:\s*(https?:\/\/[^\s\n]+)/ig, '👑 <b><a href="$2">$1</a></b>');
    // Converts ANY label after 🔗 (Main Link, Mirror Link, VexFile, Upfiles, 10Drives, etc.) into a clickable HTML link
    html = html.replace(/🔗\s*([^:\n]+?)\s*:\s*(https?:\/\/[^\s\n]+)/ig, '🔗 <b><a href="$2">$1</a></b>');
    return html;
  };

  const handleSendToTelegram = (overrideTgCode = null, overrideVipUrl = null) => {
    const isAutoTriggered = typeof overrideTgCode === 'string';
    let currentTgCode = isAutoTriggered ? overrideTgCode : (activeMainTab === 'database' ? dbTelegramResult : telegramResult);
    let rawImgUrl = headerImage ? headerImage.original : (silentImage ? silentImage : (customImages[0] || ""));
    
    if (!rawImgUrl || !currentTgCode) return alert(rawImgUrl ? "Fetch post data first!" : "Promo Image missing!");
    
    if (!isAutoTriggered && currentTgCode.match(/\[\s*MB\s*\]/i)) {
        const confirmSend = window.confirm("Aapne size nahi daala hai, kya bina size bhejna chahte hain?");
        if (!confirmSend) return;
    }

    // Use =s1080 instead of huge =s0 so Telegram servers download & post 3x faster
    let imageUrlToSend = rawImgUrl.replace(/=s0$/, "=s1080");
    const formattedTgHtml = formatTelegramHtml(currentTgCode);

    // Check if we should also auto-edit VIP Channel APK Caption in parallel
    let vipLinkToSend = "";
    let vipCaptionToSend = "";
    if (settings.autoEditVipApk) {
        const existingExtracted = extractExistingTgLinks(currentTgCode);
        vipLinkToSend = (
            (typeof overrideVipUrl === 'string' ? overrideVipUrl : "") ||
            (activeMainTab === 'database' ? (dbVipLink || getVipLinkForPkg(dbAppId)) : (genVipLink || getVipLinkForPkg(playStoreUrl || link))) ||
            existingExtracted.vipUrl ||
            ""
        ).trim();
        if (vipLinkToSend) {
            const targetPlayUrl = playStoreUrl || (dbAppId ? `https://play.google.com/store/apps/details?id=${dbAppId}` : "");
            vipCaptionToSend = formatVipApkCaptionHtml(currentTgCode, targetPlayUrl, settings.vipIncludeDesc);
        }
    }
    
    setIsSendingTg(true); 
    
    fetch("/api/send-to-tg", { 
        method: "POST", headers: { "Content-Type": "application/json" }, 
        keepalive: true,
        body: JSON.stringify({
            image: imageUrlToSend,
            caption: formattedTgHtml,
            vipLink: vipLinkToSend,
            vipCaption: vipCaptionToSend
        }) 
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            const vipNote = data.vipEdited ? ` + VIP #${data.vipMessageId || ""} Edited` : "";
            setTgToast(`✅ Sent to Telegram${vipNote}`);
            setTimeout(() => setTgToast(""), 3000);
        } else {
            console.error("Telegram API Error:", data.error);
            setTgToast("❌ Failed to Send");
            setTimeout(() => setTgToast(""), 3000);
        }
    })
    .catch(err => {
        console.error("Network Error sending TG", err);
        setTgToast("❌ Network Error");
        setTimeout(() => setTgToast(""), 3000);
    })
    .finally(() => {
        setIsSendingTg(false); 
    });
  };

