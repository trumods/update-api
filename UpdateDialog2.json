"use client";
import { useState, useEffect, useRef } from "react";

// ================== SMART TITLE / VERSION / BUILD HELPERS ==================
// Works with any version style: v1.2.3 | vT1.2.3 | vt.1.2.3 | v2026.10.14 | v1.0-beta
// Build detection: b123 | B123 | build 123 | Build123 | build-123 | (b123) | [b123]
const normalizeBuild = (raw) => {
  const t = String(raw || "").trim().replace(/\s+/g, " ");
  if (!t) return "";
  if (/^\d+$/.test(t)) return `b${t}`;
  const m = t.match(/^(build|b)\s*[-_.:#]?\s*(\d+)$/i);
  if (m) return /^build$/i.test(m[1]) ? `${m[1]} ${m[2]}` : `${m[1]}${m[2]}`;
  return t;
};

const BUILD_ONLY_RE = /^[\(\[\{]?\s*(?:build|b)\s*[-_.:#]?\s*\d+\s*[\)\]\}]?$/i;

const extractBuild = (txt) => {
  const s = String(txt || "");
  const m = s.match(/(^|\s)[\(\[\{]?\s*((?:build|b)\s*[-_.:#]?\s*\d+)\s*[\)\]\}]?(?=\s|$)/i);
  if (!m) return { build: "", rest: s.replace(/\s+/g, " ").trim() };
  const rest = (s.slice(0, m.index) + " " + s.slice(m.index + m[0].length)).replace(/\s+/g, " ").trim();
  return { build: normalizeBuild(m[2]), rest };
};

// Splits "Name (Custom) vT1.2.3 b123 [Premium]" => { name, prefix, version, build, extra, tier, tag }
// paren=true is used for the Telegram line:  "v1.2.3 b123 (Premium)"
const parseTitleParts = (rawTitle, paren = false) => {
  let s = String(rawTitle || "").replace(/\s+/g, " ").trim();
  let tag = "";
  const tagM = s.match(/((?:\s+#[^\s#]+)+)$/);
  if (tagM) { tag = tagM[1].trim(); s = s.slice(0, tagM.index).trim(); }

  let tier = "";
  let build = "";
  const tierRe = paren ? /\s*(\([^()]*\))$/ : /\s*(\[[^\[\]]*\])$/;
  for (let i = 0; i < 2; i++) {
    const tm = s.match(tierRe);
    if (!tm) break;
    if (BUILD_ONLY_RE.test(tm[1])) {
      if (!build) build = normalizeBuild(tm[1].replace(/^[\(\[\{]|[\)\]\}]$/g, ""));
      s = s.slice(0, tm.index).trim();
      continue;
    }
    if (!tier) { tier = tm[1]; s = s.slice(0, tm.index).trim(); }
    break;
  }

  const re = /(^|\s)(v[A-Za-z]{0,2}\.?(?=\d)[^\s\[\](){}]*)/g;
  let found = null;
  let m;
  while ((m = re.exec(s)) !== null) found = { index: m.index + m[1].length, token: m[2] };

  if (!found) {
    return { name: s, prefix: "", version: "", build, extra: "", tier, tag, hasVersion: false };
  }
  const name = s.slice(0, found.index).trim();
  const after = s.slice(found.index + found.token.length).trim();
  const pm = found.token.match(/^v[A-Za-z]{0,2}\.?(?=\d)/);
  const prefix = pm ? pm[0] : "v";
  const version = found.token.slice(prefix.length);
  const eb = extractBuild(after);
  return { name, prefix, version, build: eb.build || build, extra: eb.rest, tier, tag, hasVersion: true };
};

const composeTitle = ({ name, prefix, version, build, extra, tier, tag }) => {
  const ver = version ? `${prefix || "v"}${String(version).replace(/^v(?=\d)/i, "")}` : "";
  return [name, ver, build, extra, tier, tag].filter(Boolean).join(" ").replace(/\s+/g, " ").trim();
};

// Rewrites only the "♻️ v1.2.3 b123 (Premium)" line of a Telegram post
// opts.build: undefined = keep existing build, "" = remove build, "b123" = set build
const updateTgVersionLine = (tgText, opts = {}) => {
  if (!tgText) return tgText;
  const lineRe = /^♻\uFE0F?[ \t]*(.*)$/m;
  const m = tgText.match(lineRe);
  if (!m) return tgText;
  const p = parseTitleParts(m[1], true);
  if (!p.hasVersion) {
    if (!opts.version) return tgText;
    return tgText.replace(/^(♻\uFE0F?[ \t]*v)[^\s(]+/m, (mm, a) => `${a}${opts.version}${opts.build ? " " + opts.build : ""}`);
  }
  const tierOut = opts.tier ? `(${String(opts.tier).replace(/^[\[\(]|[\]\)]$/g, "")})` : p.tier;
  const line = composeTitle({
    name: "",
    prefix: opts.prefix || p.prefix,
    version: opts.version ? opts.version : p.version,
    build: opts.build === undefined ? p.build : opts.build,
    extra: p.extra,
    tier: tierOut,
    tag: p.tag
  });
  return tgText.replace(lineRe, () => `♻️ ${line}`);
};

// Keeps custom bracket name, e.g. DB: "Notification History (Norg)" + PlayStore: "Notification History"
// => "(Norg)" is kept. If PlayStore itself already has that bracket, it is never duplicated.
const getCustomBracketSuffix = (dbName, psTitle) => {
  const n = String(dbName || "").replace(/\s+/g, " ").trim();
  const p = String(psTitle || "").replace(/\s+/g, " ").trim();
  if (!n || !p) return "";
  const nl = n.toLowerCase();
  const pl = p.toLowerCase();
  if (nl.startsWith(pl)) {
    const rest = n.slice(p.length).trim();
    if (!rest) return "";
    if (/^(?:\([^()]*\)\s*)+$/.test(rest)) return rest.replace(/\s+/g, " ").trim();
  }
  const gm = n.match(/((?:\s*\([^()]*\))+)\s*$/);
  if (!gm) return "";
  const groups = gm[1].match(/\([^()]*\)/g) || [];
  return groups.filter(g => !pl.includes(g.toLowerCase())).join(" ");
};

const normVer = (v) => String(v || "").trim().toLowerCase().replace(/^[a-z]{0,3}\.?(?=\d)/, "");
// ===========================================================================


// ================== SMART DESCRIPTION FORMATTER (universal, pure functions) ==================
// formatDescription({ html, text, summary }, cfg) => { overview, body }
//   cfg.mode: 'smart' (default) | 'plain'
// Smart  : removes emojis, detects headings/bullets/labels/links, applies bold/colour/italic rules
// Plain  : Play Store text as-is (summary as overview), only emojis + extra spaces removed
const DF_KEEP = "\u2194\u2195\u00A9\u00AE\u2122\u2605\u2606\u2714\u2713\u2718\u2717\u2726\u2730\u279C\u27A5\u2192\u2190\u25AA\u25CF\u25A0\u25C6\u2022\u00B7";
const DF_EMOJI_SRC = "(?:(?![" + DF_KEEP + "])\\p{Extended_Pictographic}|[\\u{1F1E6}-\\u{1F1FF}\\u{1F3FB}-\\u{1F3FF}\\uFE0F\\u200D\\u20E3\\u{E0020}-\\u{E007F}])";
const DF_EMOJI_G = new RegExp(DF_EMOJI_SRC, "gu");
const DF_EMOJI_1 = new RegExp("^" + DF_EMOJI_SRC, "u");

// inline markers (private-use chars)
const DB1 = "\uE000", DB0 = "\uE001"; // bold
const DL1 = "\uE002", DL2 = "\uE003", DL3 = "\uE004"; // link: DL1 url DL2 text DL3
const DI1 = "\uE005", DI0 = "\uE006"; // italic
const DR1 = "\uE007", DR0 = "\uE008"; // red
const DF_MARK_RE = /[\uE000-\uE008]/g;
const DF_LINK_RE = /\uE002([^\uE003]*)\uE003([^\uE004]*)\uE004/g;

const dfCodePoint = (n) => { try { return String.fromCodePoint(n); } catch (e) { return ""; } };
const dfDecode = (s) => s
  .replace(/&nbsp;/gi, " ")
  .replace(/&#x([0-9a-f]+);/gi, (m, h) => dfCodePoint(parseInt(h, 16)))
  .replace(/&#(\d+);/g, (m, d) => dfCodePoint(parseInt(d, 10)))
  .replace(/&quot;/gi, '"').replace(/&apos;/gi, "'")
  .replace(/&lt;/gi, "<").replace(/&gt;/gi, ">").replace(/&amp;/gi, "&");

const dfVisible = (s) => String(s || "").replace(DF_LINK_RE, "$2").replace(DF_MARK_RE, "");
const dfWords = (s) => (String(s || "").match(/\S+/g) || []).length;
const dfCollapse = (s) => String(s || "").replace(/\s+/g, " ").trim();

// ---- 1. HTML / text  ->  marked lines ----
const dfParseSource = (src) => {
  let s = String(src || "").replace(/\r\n?/g, "\n");
  s = s.replace(/<h[1-6][^>]*>/gi, "\n" + DB1).replace(/<\/h[1-6]>/gi, DB0 + "\n");
  s = s.replace(/<br\s*\/?>/gi, "\n").replace(/<\/(?:p|div|ul|ol)>/gi, "\n").replace(/<li[^>]*>/gi, "\n\u2022 ").replace(/<\/li>/gi, "\n");
  s = s.replace(/<(?:b|strong)(?:\s[^>]*)?>/gi, DB1).replace(/<\/(?:b|strong)>/gi, DB0);
  s = s.replace(/<(?:i|em)(?:\s[^>]*)?>/gi, DI1).replace(/<\/(?:i|em)>/gi, DI0);
  s = s.replace(/<a\s[^>]*?href\s*=\s*["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi, (m, url, txt) => DL1 + url.trim() + DL2 + txt.replace(/<[^>]+>/g, "") + DL3);
  s = s.replace(/<\/?(?:b|strong|i|em|u|a|br|p|div|span|ul|ol|li|h[1-6]|font|center|small|big|sub|sup|img|table|tr|td|th|hr|blockquote|code|pre|s|strike|del|ins|mark|abbr)\b[^>\n]{0,300}>/gi, "");
  s = dfDecode(s);
  s = s.replace(/[\u200B\uFEFF]/g, "").replace(/[\u00A0\t]+/g, " ");
  s = s.replace(new RegExp(DB0 + "([ ]*)" + DB1, "g"), "$1");
  // balance bold / italic markers (per line, drop stray closers)
  return s.split("\n").map(l => {
    let bo = false, io = false;
    let out = "";
    for (const ch of l) {
      if (ch === DB1) { if (!bo) { bo = true; out += ch; } }
      else if (ch === DB0) { if (bo) { bo = false; out += ch; } }
      else if (ch === DI1) { if (!io) { io = true; out += ch; } }
      else if (ch === DI0) { if (io) { io = false; out += ch; } }
      else out += ch;
    }
    if (!l.trim()) return "";
    out = out + (bo ? DB0 : "") + (io ? DI0 : "");
    return out.replace(/ {2,}/g, " ").trim();
  });
};

// ---- helpers ----
const DF_BULLET_RE = /^(?:([•●▪◦‣∙■□◆◇○▫➢➤►▶»›→➜➔➥✓✔✘✗✕★☆✦✰◉⦿⦾])\s*|([*\-–—·])\s+)/u;
const DF_PLAIN_SYMS = "•◦‣∙·-*–—○▫";
const DF_SYM_KIND = (sym) => {
  if (!sym) return "";
  if (sym === "emoji") return "emoji";
  if (/[✓✔✘✗✕]/.test(sym)) return "check";
  if (DF_PLAIN_SYMS.indexOf(sym) !== -1) return "plain";
  return "deco";
};
const DF_SKIP_ONLY_RE = /^[\s\-–—_=*·•~━─═.|]*$/;

const dfStripEmoji = (s) => s.replace(DF_EMOJI_G, "").replace(new RegExp(DB1 + "\\s*" + DB0, "g"), "").replace(new RegExp(DI1 + "\\s*" + DI0, "g"), "").replace(/ {2,}/g, " ").trim();

// "* Notice *", "- Taking a Note -", "=== Features ===", "~ Tips ~", "<< More >>"  (same symbol at both ends)
const dfSymClass = (x, lead) => {
  x = x.replace(/\s/g, ""); if (!x) return "";
  if (/^\*+$/.test(x)) return "*"; if (/^[-–—]+$/.test(x)) return "-"; if (/^=+$/.test(x)) return "=";
  if (/^~+$/.test(x)) return "~"; if (/^_+$/.test(x)) return "_"; if (/^#+$/.test(x)) return "#"; if (/^\|+$/.test(x)) return "|";
  if (lead ? /^[<«]+$/.test(x) : /^[>»]+$/.test(x)) return "<>";
  if (/^[•●▪■◆★☆✦✧✪❖·]+$/.test(x)) return "b";
  return "";
};
const dfWrapped = (vis) => {
  const m = vis.match(/^([^\p{L}\p{N}\s(\[{"'“‘]{1,6})\s*([\p{L}\p{N}].*?)\s*([^\p{L}\p{N}\s)\]}"'”’.!?:;,]{1,6})$/u);
  if (!m) return null;
  const lc = dfSymClass(m[1], true), tc = dfSymClass(m[3], false);
  if (!lc || lc !== tc) return null;
  const inner = m[2].trim();
  if (dfWords(inner) > 10 || /[.!;,]$/.test(inner)) return null;
  return inner;
};

// ---- 2. classify lines ----
const dfClassify = (rawLines) => {
  const items = [];
  for (const l of rawLines) {
    if (!l) { items.push({ t: "blank" }); continue; }
    const wrapped = dfWrapped(dfVisible(l));
    if (wrapped) {
      const wv = dfStripEmoji(wrapped);
      if (wv) { items.push({ t: "text", s: DB1 + wv + DB0, vis: wv, sym: null, kind: "", emoji: false, decorated: true }); continue; }
    }
    const first = l.replace(/^[\uE000\uE005\s]+/, "");
    const startsEmoji = DF_EMOJI_1.test(first);
    let sym = null, body = l;
    const bm = l.match(DF_BULLET_RE);
    if (bm) { sym = bm[1] || bm[2]; body = l.slice(bm[0].length); }
    else if (startsEmoji) { sym = "emoji"; }
    body = dfStripEmoji(body);
    let vis = dfVisible(body);
    if (!vis) { if (sym === null) items.push({ t: "blank" }); continue; }
    if (DF_SKIP_ONLY_RE.test(vis)) { items.push({ t: "blank" }); continue; }
    // decorated lines:  >>> TITLE...   ***IMPORTANT***   ## Title   | - Title - |   [Title]
    let decorated = false;
    if (sym === null || sym === "emoji") {
      const lead = vis.match(/^[\s|>»=*#~_<\-–—]+/);
      const trail = vis.match(/[\s|>«=*#~_<\-–—]+$/);
      const leadN = lead ? lead[0].replace(/\s/g, "").length : 0;
      const trailN = trail ? trail[0].replace(/\s/g, "").length : 0;
      if (leadN >= 2 || /^#{1,6}\s/.test(vis) || (leadN >= 1 && trailN >= 1)) {
        const inner = vis.replace(/^[\s|>»=*#~_<\-–—]+/, "").replace(/[\s|>«=*#~_<\-–—]+$/, "").replace(/(?:\.{2,}|…)$/, "").trim();
        if (inner && dfWords(inner) <= 10 && !/[.!;,]$/.test(inner)) { body = DB1 + inner + DB0; decorated = true; }
        else if (inner) { body = body.replace(/^[\s|>»=*#~_<\-–—]+/, "").replace(/[\s|>«=*#~_<\-–—]+$/, ""); }
        vis = dfVisible(body);
      }
      const br = !decorated && vis.match(/^\[([^\]\n]{2,50})\]$/);
      if (br) { body = DB1 + br[1] + DB0; decorated = true; vis = br[1]; }
    }
    body = body.replace(/\*\*([^*\n]+?)\*\*/g, DB1 + "$1" + DB0).replace(/ [-–—]+$/, "");
    body = body.replace(/^\[\s*([^\]\n]{2,40}?)\s*\]\s+(?=\S)/, (m, lab) => /^https?:/i.test(lab) ? m : DB1 + lab + DB0 + " ");
    const cjk = body.match(/^【([^】]+)】\s*(.*)$/);
    if (cjk) body = DB1 + cjk[1] + DB0 + (cjk[2] ? " " + cjk[2] : "");
    const num = !sym && /^\d{1,2}[.)]\s+\S/.test(dfVisible(body));
    const kind = DF_SYM_KIND(sym);
    items.push({ t: num ? "num" : (sym && sym !== "emoji" ? "bullet" : "text"), s: body, vis: dfVisible(body), sym: sym, kind: kind, emoji: sym === "emoji", decorated: decorated });
  }
  return items;
};

const dfNextContent = (items, i) => { let j = i + 1; while (j < items.length && items[j].t === "blank") j++; return items[j] || null; };

// symbol / emoji led short line followed by plain content  =>  section heading ("📂 Smart File Manager", "◆ Home")
const dfSymHeading = (items, i) => {
  const it = items[i];
  if (!(it.kind === "emoji" || it.kind === "deco")) return null;
  if (it.s.indexOf(DL1) !== -1 || /https?:\/\//i.test(it.vis)) return null;
  if (dfWords(it.vis) > 8 || /[.!;,]$/.test(it.vis)) return null;
  const nx = dfNextContent(items, i);
  if (!nx) return null;
  if (nx.kind === "emoji" || nx.kind === "deco") return null;
  return "sym";
};

const DF_QA_RE = /^[QA]\s*[:.)]\s*\S/;
const dfHeadingKind = (items, i) => {
  const it = items[i];
  if (it.vis && DF_QA_RE.test(it.vis)) return null;
  if (it.decorated && it.t === "text") return "deco";
  if (it.t === "text" && it.emoji) return dfSymHeading(items, i);
  if (it.t === "bullet") return dfSymHeading(items, i);
  if (it.t !== "text") return null;
  const v = it.vis;
  if (!v || it.s.indexOf(DL1) !== -1 || /https?:\/\//i.test(v)) return null;
  const words = dfWords(v);
  const boldOnly = new RegExp("^" + DB1 + "[^" + DB1 + DB0 + "]*" + DB0 + ":?$").test(it.s.trim());
  if (boldOnly && words <= 12 && !/[.!]$/.test(v)) return "bold";
  if (/:$/.test(v) && words <= 9) return "colon";
  const letters = v.replace(/[^A-Za-z]/g, "");
  if (letters.length >= 3 && letters === letters.toUpperCase() && words <= 10 && !/[.!;,]$/.test(v)) return "caps";
  if (it.emoji || i === 0) return null;
  if (words <= 8 && !/[.!;,:]$/.test(v) && /^[A-Z0-9]/.test(v)) {
    const prev = items[i - 1];
    if (!prev || prev.t !== "blank") return null;
    let j = i + 1; while (j < items.length && items[j].t === "blank") j++;
    const next = items[j];
    if (next && (next.t === "bullet" || next.t === "num" || (next.t === "text" && dfWords(next.vis) >= 8))) return "short";
  }
  return null;
};

// ---- sentence helper (safe for v2.0, e.g., URLs, abbreviations) ----
const dfSentences = (text) => {
  const P = "\uE010";
  let s = String(text || "");
  s = s.replace(/https?:\/\/\S+/g, (m) => m.replace(/\./g, P));
  s = s.replace(/\b(?:e\.g|i\.e|etc|vs|Mr|Mrs|Ms|Dr|Prof|Inc|Ltd|Co|St|No|approx|a\.m|p\.m|U\.S|U\.K)\./gi, (m) => m.replace(/\./g, P));
  s = s.replace(/(\w)\.(?=\w)/g, "$1" + P);
  const pieces = s.match(/[^.!?…]+(?:[.!?…]+["')\]”’]*|$)\s*/g) || [s];
  const out = [];
  for (const p of pieces) {
    const t = p.trim(); if (!t) continue;
    if (out.length && /^[a-z]/.test(t)) out[out.length - 1] += " " + t; else out.push(t);
  }
  return out.map(x => x.replace(new RegExp(P, "g"), "."));
};

const dfCutWords = (text, max) => {
  const w = text.split(/\s+/);
  if (w.length <= max) return text;
  let cut = w.slice(0, max).join(" ");
  const k = Math.max(cut.lastIndexOf(", "), cut.lastIndexOf("; "), cut.lastIndexOf(" - "));
  if (k > cut.length * 0.55) cut = cut.slice(0, k);
  return cut.replace(/[,;:\-\s]+$/, "") + "...";
};

// ---- 3. overview extraction (first prose paragraph, <= 50 words) ----
const dfJoin = (a, b) => { a = String(a || "").replace(/[\s,;:\-–—]+$/, ""); return a ? a + (/[.!?…]$/.test(a) ? "" : ".") + " " + b : b; };
const dfNorm = (t) => String(t || "").toLowerCase().replace(/[^a-z0-9]+/g, "");
const dfExtractOverview = (items, summary, cfg) => {
  cfg = cfg || {};
  const MAXW = Math.max(10, Math.min(120, parseInt(cfg.overviewWords, 10) || 50));
  let i = 0; while (i < items.length && items[i].t === "blank") i++;
  const paras = [];
  while (i < items.length && paras.length < 3) {
    if (items[i].t === "blank") { i++; continue; }
    if (items[i].t !== "text" || items[i].emoji || dfHeadingKind(items, i)) break;
    const start = i; const parts = [];
    while (i < items.length && items[i].t === "text" && !items[i].emoji && !dfHeadingKind(items, i)) { parts.push(items[i].vis); i++; }
    paras.push({ start, end: i, text: dfCollapse(parts.join(" ")) });
    if (i < items.length && items[i].t !== "blank") break;
  }
  const cleanSummary = dfCollapse(dfStripEmoji(summary || ""));
  const consumed = [];
  let overview = "";
  if (cfg.overviewMode === "short") {
    // TG style: short Play Store summary
    if (cleanSummary) {
      overview = dfCutWords(cleanSummary, MAXW);
      const ns = dfNorm(cleanSummary);
      if (paras[0] && ns.length > 10 && (dfNorm(paras[0].text) === ns || dfNorm(paras[0].text).indexOf(ns) === 0 || ns.indexOf(dfNorm(paras[0].text)) === 0)) consumed.push(paras[0]);
    } else if (paras[0]) {
      const sents = dfSentences(paras[0].text);
      overview = dfCutWords(sents[0] || paras[0].text, Math.min(MAXW, 20));
    }
    return { overview: dfCollapse(overview), consumed };
  }
  if (paras.length) {
    const p1 = paras[0];
    if (dfWords(p1.text) <= MAXW) {
      overview = p1.text; consumed.push(p1);
      if (dfWords(overview) < 18 && paras[1]) {
        const sents = dfSentences(paras[1].text); let used = 0; let add = "";
        for (const s of sents) {
          if (dfWords(overview + " " + add + " " + s) > MAXW) break;
          add += (add ? " " : "") + s; used++;
          if (dfWords(overview + " " + add) >= 25) break;
        }
        if (add) { overview = dfJoin(overview, add); if (used === sents.length) consumed.push(paras[1]); }
      }
    } else {
      const sents = dfSentences(p1.text); let acc = ""; let used = 0;
      for (const s of sents) { if (dfWords((acc ? acc + " " : "") + s) > MAXW) break; acc += (acc ? " " : "") + s; used++; }
      overview = acc || dfCutWords(p1.text, MAXW);
      // long first paragraph: overview takes the first sentences, the rest stays in the description (no repetition, no text lost)
      const pItems = items.slice(p1.start, p1.end);
      const plain = pItems.every(x => x.s.indexOf(DL1) === -1 && x.s.indexOf(DB1) === -1 && x.s.indexOf(DI1) === -1);
      if (acc && used < sents.length && plain && (pItems.length === 1 || p1.text.split(/\s+/).length / pItems.length >= 12)) {
        consumed.push({ start: p1.start, end: p1.end, remainder: sents.slice(used).join(" ") });
      }
    }
  }
  if (dfWords(overview) < 12 && cleanSummary) {
    if (!overview) overview = cleanSummary;
    else if (dfNorm(overview).indexOf(dfNorm(cleanSummary).slice(0, 20)) === -1) overview = dfJoin(overview, cleanSummary);
  }
  overview = overview.replace(/^[\s>»=*#~_|<\-–—•●▪]+/, "");
  return { overview: dfCollapse(overview), consumed };
};

// ---- colours / categories ----
const DF_RE_RED = /^\W*(?:note|notes|notice|important|warning|attention|caution|restrictions?|not supported)\b|\b(?:permissions?|disclaimer)\b/i;
const DF_RE_PURPLE = /\b(premium|pro|plus|vip|subscriptions?|subscribe|upgrade|plans?|pricing|unlock|paid)\b/i;
const DF_RE_BLUE = /\b(features?|highlights?|includes?|including|capabilit\w+|what you can|key|how (to|it works)|get(ting)? started|to (begin|get started)|use cases?|supported|compatib\w+|works with|designed for|perfect for|more|additional|main|core)\b/i;
const DF_RE_GREEN = /\b(why|benefits?|advantages?|free|offline|tips?|pro tips|what's new)\b/i;
const DF_RE_NOCOLOR = /\b(follow us|contact|support|privacy|terms|facebook|instagram|twitter|telegram|reddit|youtube|discord|website|feedback)\b/i;

const dfHeadingColor = (text, cfg) => {
  if (!cfg.enableColors) return "";
  if (DF_RE_NOCOLOR.test(text) && !DF_RE_RED.test(text)) return "";
  if (DF_RE_RED.test(text)) return "red";
  const forced = cfg.headingColor && cfg.headingColor !== "random" ? cfg.headingColor : "";
  if (DF_RE_PURPLE.test(text)) return forced || "purple";
  if (DF_RE_BLUE.test(text)) return forced || "blue";
  if (DF_RE_GREEN.test(text)) return forced || "green";
  return "";
};

const DF_BULLET_MAP = {
  "•": "•", "◦": "•", "‣": "•", "∙": "•", "·": "•", "○": "•", "▫": "•", "-": "•", "*": "•", "–": "•", "—": "•", "emoji": "•", "auto": "•",
  "●": "●", "◉": "●", "⦿": "●", "⦾": "●",
  "■": "▪", "□": "▪", "◆": "▪", "◇": "▪", "▪": "▪",
  "➢": "➜", "➤": "➜", "►": "➜", "▶": "➜", "»": "➜", "›": "➜", "→": "➜", "➜": "➜", "➔": "➜", "➥": "➜",
  "★": "★", "☆": "★", "✦": "✦", "✰": "✦"
};

const dfChooseBullet = (items, cfg) => {
  if (cfg.bulletStyle && cfg.bulletStyle !== "auto") return cfg.bulletStyle;
  const cnt = {};
  for (const it of items) {
    if (it.t !== "bullet" && !(it.t === "text" && it.emoji)) continue;
    if (/[✓✔✘✗✕]/.test(it.sym || "")) continue;
    const k = DF_BULLET_MAP[it.sym] || "•";
    cnt[k] = (cnt[k] || 0) + 1;
  }
  let best = "•", bc = 0;
  for (const k of Object.keys(cnt)) if (cnt[k] > bc) { best = k; bc = cnt[k]; }
  return best;
};

const DF_RE_DISCLAIMER = /(automatically renew|auto-?renew|payment will be charged|cancel(?:led|lation)? at least|all rights reserved|registered trademark|not affiliated|terms (?:of|and) (?:service|use)|privacy policy|subscription (?:will|may)|free trial will)/i;
const DF_RE_NOTE_LABEL = /^(note|notes|important|disclaimer|warning|attention|notice|caution)$/i;

const dfBbSafe = (s) => s.replace(/\[(\/?)(b|i|u|s|url|img|color|size|code|list|quote|break|attachment|flash|spoiler)\b([^\]]*)\]/gi, "($1$2$3)");

const dfLinkBb = (url, text) => {
  const norm = (x) => x.replace(/^https?:\/\//i, "").replace(/^www\./i, "").replace(/\/+$/, "").toLowerCase();
  if (!text || norm(text) === norm(url) || norm(url).indexOf(norm(text)) === 0) return "[url]" + url + "[/url]";
  return "[url=" + url + "]" + text + "[/url]";
};

const dfInline = (raw, opts) => {
  let s = raw;
  // label: bold (red for notes)
  if (opts.labels && s.indexOf(DL1) === -1 && !/^[\uE000-\uE008]/.test(s)) {
    const m = s.match(/^([^\uE000-\uE008:\n]{2,45}?) ?:(?=\s)/);
    if (m && /^[A-Z0-9]/.test(m[1]) && !/https?:/i.test(m[1]) && dfWords(m[1]) <= opts.maxLabel && !/\d:\d/.test(m[0])) {
      const red = opts.colors && DF_RE_NOTE_LABEL.test(m[1].trim());
      s = DB1 + (red ? DR1 : "") + m[0] + (red ? DR0 : "") + DB0 + s.slice(m[0].length);
    }
  }
  // split by links, convert bare urls only in plain parts
  const parts = s.split(/(\uE002[^\uE003]*\uE003[^\uE004]*\uE004)/);
  s = parts.map((p, idx) => {
    if (idx % 2 === 1) { const mm = p.match(/^\uE002([^\uE003]*)\uE003([^\uE004]*)\uE004$/); return mm ? dfLinkBb(mm[1], mm[2]) : p; }
    return dfBbSafe(p).replace(/(https?:\/\/[^\s\uE000-\uE008<>\[\]"]+?)([.,;:!?)]*)(?=\s|$|[\uE000-\uE008])/g, "[url]$1[/url]$2");
  }).join("");
  return s.replace(/\uE000/g, "[b]").replace(/\uE001/g, "[/b]").replace(/\uE005/g, "[i]").replace(/\uE006/g, "[/i]")
          .replace(/\uE007/g, "[color=red]").replace(/\uE008/g, "[/color]");
};

const DF_RE_SOC1 = /^(follow us|like us|find us|connect with us|join (us|our)|visit (us|our)|stay connected|social media|contact us)\b/i;
const DF_RE_SOC2 = /^(facebook|instagram|twitter|x|youtube|telegram|discord|tiktok|linkedin|reddit|website|web|email|e-mail)\s*[:@|]/i;
const dfDropSocial = (items) => items.filter(it => {
  if (it.t === "blank" || it.t === "num") return true;
  const v = it.vis || "";
  return !(DF_RE_SOC1.test(v) || DF_RE_SOC2.test(v));
});

// blank-line modes:  smart (default) = keep every single source gap, but merge "spaced lists" (bullets separated one-by-one by blank lines)
//                    keep = exactly like source | none = remove all empty lines
const dfTidyBlanks = (items) => {
  const isB = (x) => x && (x.t === "bullet" || x.t === "num");
  const n = items.length;
  const prevRun = new Array(n).fill(0), nextRun = new Array(n).fill(0);
  for (let i = 0; i < n; i++) prevRun[i] = isB(items[i]) ? (i > 0 && isB(items[i - 1]) ? prevRun[i - 1] + 1 : 1) : 0;
  for (let i = n - 1; i >= 0; i--) nextRun[i] = isB(items[i]) ? (i < n - 1 && isB(items[i + 1]) ? nextRun[i + 1] + 1 : 1) : 0;
  const out = [];
  for (let i = 0; i < n; i++) {
    if (items[i].t === "blank" && i > 0 && out.length && isB(items[i - 1])) {
      let j = i; while (j < n && items[j].t === "blank") j++;
      if (j < n && isB(items[j]) && (prevRun[i - 1] === 1 || nextRun[j] === 1)) { i = j - 1; continue; }
    }
    out.push(items[i]);
  }
  return out;
};

// ---- 4. SMART builder ----
const dfSmart = (lines, summary, cfg) => {
  let items = dfClassify(lines);
  // overview (first prose paragraph) and remove consumed paragraphs
  const ov = dfExtractOverview(items, summary, cfg);
  const drop = new Set();
  ov.consumed.forEach(p => {
    if (p.remainder) { items[p.start].s = p.remainder; items[p.start].vis = p.remainder; return; }
    for (let k = p.start; k < p.end; k++) drop.add(k);
  });
  items = items.filter((x, idx) => !drop.has(idx));
  while (items.length && items[0].t === "blank") items.shift();
  if (cfg.dropSocial) items = dfDropSocial(items);
  // headings
  for (let i = 0; i < items.length; i++) { const k = dfHeadingKind(items, i); if (k) items[i].t = "heading"; }
  // bullet-less short line runs become bullets (>=3 lines anywhere, or >=2 lines right under a heading)
  if (cfg.autoBullets !== false) {
    for (let i = 0; i < items.length;) {
      if (items[i].t === "text" && !items[i].emoji) {
        let j = i; while (j < items.length && items[j].t === "text" && !items[j].emoji && !DF_QA_RE.test(items[j].vis) && dfWords(items[j].vis) <= 14 && items[j].s.indexOf(DL1) === -1) j++;
        const len = j - i;
        if (len >= 2) {
          let p = i - 1; while (p >= 0 && items[p].t === "blank") p--;
          const underHeading = p >= 0 && items[p].t === "heading";
          const periods = items.slice(i, j).filter(x => /[.]$/.test(x.vis)).length;
          const paragraphLike = periods / len > 0.7 && len <= 3;
          if ((len >= 3 || underHeading) && !paragraphLike && i > 0) { for (let k = i; k < j; k++) { items[k].t = "bullet"; items[k].sym = "auto"; items[k].kind = "plain"; } }
        }
        i = Math.max(j, i + 1);
      } else i++;
    }
  }
  items.forEach(it => { if (it.t === "text" && it.emoji) { it.t = "bullet"; it.sym = "emoji"; } });
  const blankMode = cfg.blankMode || "smart";
  if (blankMode === "none") items = items.filter(x => x.t !== "blank");
  else if (blankMode === "smart") items = dfTidyBlanks(items);
  const bullet = dfChooseBullet(items, cfg);
  const out = []; let afterHeading = false; let pendingBlank = false;
  const push = (line) => {
    if (pendingBlank && out.length && out[out.length - 1] !== "") out.push("");
    pendingBlank = false; out.push(line);
  };
  for (const it of items) {
    if (it.t === "blank") { if (!(afterHeading && cfg.tightHeadings)) pendingBlank = true; continue; }
    if (it.t === "heading") {
      let h = dfVisible(it.s).replace(/^[\s*#_=~<>«»★☆✦♦▪•●▬━─|\-–—]+/, "").replace(/[\s*#_=~<>«»★☆✦♦▪•●▬━─|\-–—]+$/, "");
      const br = h.match(/^\[(.*)\]$/); if (br) h = br[1];
      h = h.replace(/(?:\.{2,}|…)$/, "").trim();
      if (!h) continue;
      if (cfg.uppercaseHeadings) h = h.toUpperCase();
      const color = dfHeadingColor(h, cfg);
      let line = dfBbSafe(h);
      if (color) line = "[color=" + color + "]" + line + "[/color]";
      if (cfg.boldHeadings || color) line = "[b]" + line + "[/b]";
      pendingBlank = blankMode !== "none"; push(line); afterHeading = true; pendingBlank = false; continue;
    }
    afterHeading = false;
    const italic = cfg.italicNotes && (it.t === "text" || it.t === "bullet") && dfWords(it.vis) >= 10 && DF_RE_DISCLAIMER.test(it.vis);
    const isBullet = it.t === "bullet";
    const isQ = /^Q\s*[:.)]\s*\S/.test(it.vis);
    let inner = dfInline(isQ ? it.s.replace(/[\uE000\uE001]/g, "") : it.s, { labels: !isQ && !/^A\s*[:.)]/.test(it.vis) && cfg.boldLabels !== false, maxLabel: isBullet ? 6 : 3, colors: cfg.enableColors });
    if (isQ && cfg.boldLabels !== false) inner = "[b]" + inner + "[/b]";
    if (italic) inner = "[i]" + inner + "[/i]";
    if (it.t === "num") { push(inner); continue; }
    if (isBullet) {
      let b = bullet;
      if (/[✓✔]/.test(it.sym || "")) b = "✔"; else if (/[✘✗✕]/.test(it.sym || "")) b = "✘";
      push(b + " " + inner); continue;
    }
    push(inner);
  }
  while (out.length && out[out.length - 1] === "") out.pop();
  return { overview: ov.overview, body: out.join("\n").replace(/\n{3,}/g, "\n\n").trim() };
};

// ---- 5. PLAIN builder ----
const dfPlain = (lines, summary) => {
  const out = [];
  for (const l of lines) {
    let s = l.replace(DF_LINK_RE, (m, url, txt) => {
      const norm = (x) => x.replace(/^https?:\/\//i, "").replace(/\/+$/, "").toLowerCase();
      return (!txt || norm(txt) === norm(url) || norm(url).indexOf(norm(txt)) === 0) ? (txt || url) : txt + " (" + url + ")";
    });
    s = s.replace(DF_MARK_RE, "").replace(DF_EMOJI_G, "").replace(/ {2,}/g, " ").trim();
    if (!s) { if (!l || !dfVisible(l).trim() || l.trim() === "") out.push(""); else if (!DF_EMOJI_1.test(l.trim()) ) out.push(""); continue; }
    out.push(s);
  }
  while (out.length && out[0] === "") out.shift();
  while (out.length && out[out.length - 1] === "") out.pop();
  let body = out.join("\n").replace(/\n{3,}/g, "\n\n");
  let overview = dfCollapse(dfStripEmoji(summary || ""));
  if (!overview) { const first = (body.split(/\n\s*\n/)[0] || ""); overview = dfCutWords(dfCollapse(first), 50); }
  return { overview, body };
};

const formatDescription = (data, cfg = {}) => {
  const c = { mode: "smart", boldHeadings: true, enableColors: true, headingColor: "random", italicNotes: true, uppercaseHeadings: false, bulletStyle: "auto", boldLabels: true, overviewMode: "auto", overviewWords: 50, autoBullets: true, dropSocial: false, tightHeadings: false, blankMode: "smart", ...cfg };
  if (c.mode === "smart_short") { c.mode = "smart"; c.overviewMode = "short"; }
  const src = (data && data.html && String(data.html).trim()) ? data.html : (data ? data.text : "");
  const lines = dfParseSource(src);
  const res = c.mode === "plain" ? dfPlain(lines, data && data.summary) : dfSmart(lines, data && data.summary, c);
  if (!res.body || !res.body.trim()) return { overview: res.overview || "", body: dfCollapse(dfVisible(String(src || ""))) };
  return res;
};
// ===============================================================================================

// ================== SHORT LINK ENGINE (persistent cache + background prefetch + retry) ==================
const SL_KEY = "mobilismShortCacheV2";
const slMem = new Map();
const slInflight = new Map();
let slLoaded = false;
const slLoad = () => {
  if (slLoaded || typeof window === "undefined") return;
  slLoaded = true;
  try { const o = JSON.parse(localStorage.getItem(SL_KEY) || "{}"); Object.keys(o).forEach(k => slMem.set(k, o[k])); } catch (e) {}
};
const slSave = () => {
  try { const arr = Array.from(slMem.entries()).slice(-600); localStorage.setItem(SL_KEY, JSON.stringify(Object.fromEntries(arr))); } catch (e) {}
};
const slKey = (u, p) => String(p || "shortxlinks").toLowerCase() + "::" + String(u || "").trim();
const slSkip = (u, p) => { const x = String(u || "").trim(); return !x || !/^https?:\/\//i.test(x) || String(p || "").toLowerCase() === "none" || /^https?:\/\/example\.com/i.test(x); };
const slDelay = (ms) => new Promise(r => setTimeout(r, ms));

// ek link: {url, ok} deta hai, kabhi throw nahi karta, background me 3 baar retry karta hai
const slFetchOne = (u, p) => {
  slLoad();
  const url = String(u || "").trim();
  const prov = p || "shortxlinks";
  if (slSkip(url, prov)) return Promise.resolve({ url, ok: true });
  const key = slKey(url, prov);
  if (slMem.has(key)) return Promise.resolve({ url: slMem.get(key), ok: true });
  if (slInflight.has(key)) return slInflight.get(key);
  const job = (async () => {
    const delays = [0, 1200, 3500];
    for (let i = 0; i < delays.length; i++) {
      if (delays[i]) await slDelay(delays[i]);
      try {
        const ctl = new AbortController();
        const tid = setTimeout(() => ctl.abort(), 14000);
        const res = await fetch("/api/db", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ action: "shorten_links", urls: [url], providers: [prov] }), signal: ctl.signal });
        clearTimeout(tid);
        const data = await res.json();
        if (data && data.success && Array.isArray(data.shortened) && data.shortened[0]) {
          const out = data.shortened[0];
          const ok = Array.isArray(data.ok) ? !!data.ok[0] : out !== url;
          if (ok) { slMem.set(key, out); slSave(); return { url: out, ok: true }; }
        }
      } catch (e) {}
    }
    return { url, ok: false };
  })().finally(() => { slInflight.delete(key); });
  slInflight.set(key, job);
  return job;
};

// max waitMs tak wait; job background me chalta rehta hai (result .pending me milta hai)
const slGet = async (u, p, waitMs) => {
  const job = slFetchOne(u, p);
  let tid;
  const timeout = new Promise(res => { tid = setTimeout(() => res(null), waitMs); });
  const r = await Promise.race([job, timeout]);
  clearTimeout(tid);
  if (r) return r;
  return { url: String(u || "").trim(), ok: false, pending: job };
};
const slPrefetch = (urls, provs) => { try { urls.forEach((u, i) => { if (u) slFetchOne(u, provs[i]); }); } catch (e) {} };
// ===============================================================================================

