              <div style={{ marginBottom: "20px" }}>
                <label style={{ display: "block", fontSize: "13px", fontWeight: "600", color: t.textMuted, marginBottom: "8px" }}>Bullet Style</label>
                <select value={customFormat.bulletStyle} onChange={(e) => updateCustomFormat('bulletStyle', e.target.value)} style={{ width: "100%", padding: "12px", borderRadius: "8px", backgroundColor: t.inputBg, border: `1px solid ${t.borderSolid}`, color: t.text, outline: "none" }}><option value="auto">✨ Auto (match source)</option><option value="•">• Standard</option><option value="-">- Dash</option><option value="*">* Asterisk</option><option value="✅">✅ Checkmark</option><option value="➜">➜ Arrow</option><option value="●">● Circle</option><option value="▪">▪ Square</option><option value="✔">✔ Tick</option><option value="★">★ Star</option><option value="✦">✦ Spark</option></select>
              </div>
              <button type="button" onClick={handleApplyCustomFormat} style={{ width: "100%", padding: "14px", background: "linear-gradient(135deg, #10b981, #059669)", color: "#fff", border: "none", borderRadius: "8px", fontWeight: "700", cursor: "pointer", fontSize: "15px" }}>🔄 Apply Instantly</button>
            </div>
          </div>
        )}
    </div>
  );
}
