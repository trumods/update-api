  // ---- Generate tab: description engine (Smart / Plain) ----
  const composeBBFromParts = (appData, ovText, descBody) => {
    let imageTags = "";
    let customImgs = appData.customImagesRaw || [];
    if (customImgs.length > 0) {
        imageTags = `[IMG]${customImgs[0]}[/IMG] [break]`;
        if (customImgs.length > 1) imageTags += ` ` + customImgs.slice(1).map(img => `[IMG]${img}[/IMG]`).join(' ');
    } else { imageTags = `[IMG][/IMG] [break]`; }

    const cleanDownloadLinks = appData.downloadLinks || [];
    const mainLink = cleanDownloadLinks[0] || '';
    const firstMirror = cleanDownloadLinks[1] || '';
    const extraMirrors = cleanDownloadLinks.length > 2 ? cleanDownloadLinks.slice(2).join('\n') : '';
    let mirrorSectionBBCode = `Mirror:\n${firstMirror}`;
    if (extraMirrors) mirrorSectionBBCode += `\n${extraMirrors}`;

    const modFeatureText = appData.tier === "Premium" ? "Premium features unlocked;" : `${appData.tier} / Paid features unlocked;`;

    const newBBCode = `[b]${appData.postTitle}[/b]
[u]Requirements:[/u] Android ${appData.reqText}
[u]Overview:[/u] ${ovText}

${imageTags}

${descBody}

[b][color=#FF0000]Modifications:
✪ ${modFeatureText}
✪ Removed unnecessary files;
✪ All Debug Codes Removed;
✪ CPUs: armeabi-v7a, arm64-v8a;
➥ Modded By TRUMods #FirstTimeOnNet[/color][/b]

[u]What's New:[/u]
${appData.formattedChangelog}

[b]This app has credit advertisements[/b]

[u]More Info:[/u]
[code]${appData.playStoreUrl}[/code]
[u]Download Instructions:[/u]
${mainLink}

${mirrorSectionBBCode}

Trouble downloading? Read [url=https://forum.mobilism.org/viewtopic.php?f=19&t=649944][b]This[/b][/url].`;

    return newBBCode;
  };

  // replaces ONLY the Overview line + the description between image line and Modifications (title / links / changelog edits stay untouched)
  const replaceDescriptionInBB = (bb, ovText, descBody) => {
    if (!bb) return null;
    const oi = bb.indexOf("[u]Overview:[/u]");
    if (oi === -1) return null;
    const ovEnd = bb.indexOf("\n\n[IMG]", oi);
    if (ovEnd === -1) return null;
    const imgStart = ovEnd + 2;
    const imgEnd = bb.indexOf("\n\n", imgStart);
    if (imgEnd === -1) return null;
    const modM = bb.slice(imgEnd).match(/\n\n\[b\]\[color=#?[A-Za-z0-9]+\]Modifications:/);
    if (!modM) return null;
    const modStart = imgEnd + modM.index;
    return bb.slice(0, oi) + "[u]Overview:[/u] " + ovText + "\n\n" + bb.slice(imgStart, imgEnd) + "\n\n" + descBody + bb.slice(modStart);
  };

  const buildGenerateBB = (data, cfg) => {
    if (!data || !data.rawDesc) return null;
    const f = formatDescription({ html: data.descriptionHTML, text: data.rawDesc, summary: data.summaryText }, cfg);
    if (!f || !f.body) return null;
    return sanitizeBBCodeSpacing(composeBBFromParts(data, f.overview || data.bbOverview || "", f.body));
  };

